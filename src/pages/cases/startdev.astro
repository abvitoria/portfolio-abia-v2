---
import CaseLayout from '@/layouts/CaseLayout.astro';
import CaseIntro from '@/components/case/CaseIntro.astro';
import HeroScreen from '@/components/case/startdev/HeroScreen.astro';
import LaptopFrame from '@/components/case/LaptopFrame.astro';
import PanelFigure from '@/components/case/PanelFigure.astro';
import PhoneGallery from '@/components/case/startdev/PhoneGallery.astro';
import PointsPreview from '@/components/case/startdev/PointsPreview.astro';
import Prototype from '@/components/case/startdev/Prototype.astro';
import ThemePairs from '@/components/case/startdev/ThemePairs.astro';

import cover from '@/assets/covers/capa-startdev.png';
import bench from '@/assets/case/mercado-bench.jpg';
import styleGuide from '@/assets/case/sg-clean.jpg';
import userflow from '@/assets/case/userflow.jpg';
import wireframe from '@/assets/case/wireframe-aula.png';

const summary = [
  {
    href: '#cap-descoberta',
    mark: '☍',
    title: 'Ensino + comunidade + gamificação',
    text: 'Uma proposta ambiciosa de negócio para virar uma interface única.',
    cta: 'Ver o desafio →',
  },
  {
    href: '#cap-descoberta',
    mark: '20d',
    title: 'Prazo real e apertado',
    text: 'Web e mobile em ~20 dias, com pesquisa própria limitada.',
    cta: 'Entender a restrição →',
  },
  {
    href: '#cap-decisoes',
    mark: '→',
    title: 'A direção tomada',
    text: 'Estrutura antes da estética: fluxo, wireframes, style guide e dark mode.',
    cta: 'Ver as decisões →',
  },
];

const challenge = [
  { n: '3 em 1', text: 'Ensino, comunidade e gamificação num único produto.' },
  { n: '~20 dias', text: 'Para entregar as versões web e mobile.' },
  { n: '↯', text: 'Sem pesquisa própria de usuário no início do projeto.' },
];

const steps = [
  {
    title: 'Revisão do documento de especificações',
    text: 'Li a fundo o que o cliente já havia definido de negócio e escopo, para não recomeçar do zero o que já estava resolvido.',
  },
  {
    title: 'Roteiro de entrevista',
    text: 'Montei um roteiro no Google Docs para conduzir a conversa com o cliente com foco, não uma reunião aberta, mas perguntas dirigidas às decisões de design.',
  },
  {
    title: 'Entrevista com o cliente',
    text: 'Levantei as expectativas de negócio e visuais, perguntando explicitamente sobre <strong>paleta de cores já existente</strong> e <strong>referências visuais</strong> que ele admirava o que evitou retrabalho estético mais à frente.',
  },
];

const gamification = [
  { title: 'Pontos por ajudar', text: 'Quem apoia outros usuários na comunidade acumula pontos.' },
  { title: 'Troca por cursos', text: 'Pontos viram cursos ou descontos — valor concreto de volta.' },
  {
    title: 'Recompensa por progresso',
    text: 'Completar cursos, avaliar aulas, responder atividades e interagir em fóruns rende pontos.',
  },
  { title: 'Metas visíveis', text: 'Pontuação e progresso no curso atual sempre à vista, dando sensação de avanço.' },
];

const solutions = [
  {
    title: 'Cursos e atividades',
    text: 'Uma experiência para acessar conteúdos, acompanhar módulos e realizar exercícios, com informações de progresso ao longo da jornada.',
  },
  {
    title: 'Comunidade',
    text: 'Um espaço dedicado à interação entre estudantes, permitindo criar discussões, compartilhar dúvidas e colaborar com outros participantes.',
  },
  {
    title: 'Experiência mobile',
    text: 'Adaptação das principais funcionalidades para dispositivos móveis, preservando a organização das informações e os padrões visuais da plataforma.',
  },
];

const pressure = [
  { title: 'Priorização', text: 'Estrutura antes da estética, para não desperdiçar dias em retrabalho.' },
  { title: 'Reaproveitamento', text: 'Proto-persona e marca do cliente usadas como ponto de partida legítimo.' },
  { title: 'Liderança', text: 'Manter outros projetos e apoiar uma estagiária sem travar a entrega.' },
];

const learnings = [
  {
    title: 'O que funcionou',
    items: [
      'Fazer o user flow antes de tudo permitiu estimar telas e cortar escopo cedo — foi o que fez os 20 dias caberem.',
      'Trabalhar dentro da marca do cliente, sem propor identidade nova, poupou dias de alinhamento visual.',
    ],
  },
  {
    title: 'O que eu faria diferente',
    items: [
      'Reservar espaço para pesquisa própria de usuário e validação com teste, mesmo que enxuta, defendendo isso já na negociação do prazo.',
      'Acompanhar o produto após o lançamento para fechar o ciclo com dados reais de uso.',
    ],
  },
];
---

<CaseLayout
  title="StartDev — Uma experiência de aprendizagem que conecta teoria, prática e comunidade"
  description="Ensino, comunidade colaborativa e gamificação num só produto: a interface web e mobile da StartDev, desenhada em cerca de 20 dias."
  image={cover.src}
  chapters={[
    { id: 'cap-contexto', label: 'Contexto' },
    { id: 'cap-descoberta', label: 'Investigação' },
    { id: 'cap-decisoes', label: 'Estruturação' },
    { id: 'cap-solucao', label: 'Soluções' },
    { id: 'cap-impacto', label: 'Entregas' },
  ]}
  ambient
  showLang
  cta={{ title: 'Tem um fluxo assim no seu produto?' }}
>
  <CaseIntro
    badges={[
      { label: 'UX/UI CASE', color: '#0B7C8F' },
      { label: 'EDTECH · COMUNIDADE', color: '#561589' },
      { label: 'WEB + MOBILE', color: '#6E3FC8' },
    ]}
    eyebrow="STARTDEV · PRODUCT DESIGN · UX/UI · EDTECH"
    title='Uma experiência de aprendizagem que conecta <span class="serif">teoria, prática e comunidade</span>'
    lead="A StartDev é uma plataforma de ensino de programação que combina aulas, exercícios, interação entre estudantes e um sistema de gamificação, no qual a participação e o progresso podem gerar <strong>pontos e recompensas</strong>."
    facts={[
      { label: 'PAPEL', value: 'UX/UI Designer' },
      { label: 'PLATAFORMAS', value: 'Web e mobile' },
      { label: 'DURAÇÃO', value: 'Aproximadamente 20 dias' },
      { label: 'FERRAMENTA DE DESIGN', value: 'Figma' },
      { label: 'TEMAS', value: 'Claro &amp; escuro' },
    ]}
  >
    <HeroScreen />
    <div class="card deadline">
      <span class="n">20</span>
      <span>dias, do briefing<br />à entrega final</span>
    </div>
  </CaseIntro>

  <!-- Resumo / índice -->
  <section id="cap-contexto" aria-labelledby="resumo-title" class="sec rv summary">
    <h2 id="resumo-title" class="sr-only">Resumo do case</h2>
    <div class="cols-3">
      {
        summary.map((s) => (
          <a href={s.href} class="card card--link summary-card">
            <span class="mark">{s.mark}</span>
            <div class="summary-title">{s.title}</div>
            <p>
              {s.text} <span class="more">{s.cta}</span>
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Contexto -->
  <section aria-labelledby="ctx-title" class="sec sec-narrow rv space-sm">
    <p class="eyebrow">Parte 1 · Contexto e desafio</p>
    <h2 id="ctx-title" class="h2 h2--lg">Conhecendo o projeto</h2>
    <p class="lead">
      A proposta da <strong>StartDev</strong> era oferecer uma experiência de aprendizagem que fosse além das aulas
      tradicionais, incentivando a prática e a colaboração entre estudantes.
    </p>
    <p class="lead">
      O cliente já possuía uma definição das principais funcionalidades, da identidade visual e do sistema de
      recompensas. Minha responsabilidade foi estruturar essas ideias em uma <strong
        >experiência digital consistente para web e mobile</strong
      >.
    </p>
  </section>

  <!-- O desafio real -->
  <div id="cap-descoberta" class="band band--purple space-sm">
    <section aria-labelledby="prob-title" class="sec sec-narrow rv band-inner">
      <p class="eyebrow">Contexto · O desafio</p>
      <h2 id="prob-title" class="h2 h2--xl">O desafio</h2>
      <p class="lead">
        Organizar cursos, atividades práticas, comunidade e gamificação dentro de uma navegação intuitiva, permitindo que
        os estudantes acompanhassem seu progresso e acessassem as diferentes funcionalidades com facilidade.
      </p>
      <p class="lead lead--last">
        O projeto também tinha um prazo de <strong>aproximadamente 20 dias</strong>, exigindo planejamento e validações ao
        longo do desenvolvimento das interfaces.
      </p>
      <div class="cols-3">
        {
          challenge.map((c) => (
            <div class="glass">
              <div class="glass-n">{c.n}</div>
              <div class="glass-text">{c.text}</div>
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <!-- Como cheguei na solução -->
  <section aria-labelledby="proc-title" class="sec sec-narrow rv space-lg">
    <p class="eyebrow">Parte 2 · Investigação e planejamento</p>
    <h2 id="proc-title" class="h2 h2--lg">Entendendo a proposta do cliente</h2>
    <p class="lead">
      Comecei revisando a documentação do projeto e identificando dúvidas sobre funcionalidades, regras de negócio e
      expectativas visuais. Organizei um roteiro de perguntas no Google Docs e conversei com o cliente para esclarecer
      esses pontos e compreender melhor o direcionamento esperado.
    </p>
    <p class="lead lead--last">
      Também utilizei como referência uma <strong>proto-persona</strong> já desenvolvida pelo time de Marketing.
    </p>
    <div class="rows">
      {
        steps.map((s, i) => (
          <div class="num-row">
            <span class="num-row__n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <div class="row-title">{s.title}</div>
              <div class="row-text" set:html={s.text} />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Mercado -->
  <section aria-labelledby="mkt-title" class="sec rv space-md">
    <div class="sec-narrow head">
      <p class="eyebrow">Investigação · Mercado</p>
      <h2 id="mkt-title" class="h2 h2--lg">Pesquisando referências</h2>
      <p class="lead">
        Realizei uma análise de <strong>concorrentes diretos e indiretos</strong>, reunindo plataformas de ensino,
        comunidades de desenvolvedores, produtos internacionais e referências de gamificação.
      </p>
      <p class="lead">
        Organizei essa pesquisa no Google Sheets, identificando soluções de navegação, apresentação de conteúdos e
        recursos de interação que poderiam contribuir para o desenvolvimento da StartDev.
      </p>
    </div>
    <PanelFigure
      src={bench}
      alt="Estudo comparativo de concorrentes organizado por Home, Cursos e Perfil, com prints reais das plataformas de referência"
      caption="Painel de referências de concorrentes, agrupado pelas telas-chave do produto — a base visual e funcional que sustentou as decisões seguintes."
      width={682}
    />
  </section>

  <!-- Style guide e persona -->
  <section id="cap-decisoes" aria-labelledby="ds-title" class="sec rv space-lg">
    <div class="sec-narrow head">
      <p class="eyebrow">Parte 3 · Estruturação e design</p>
      <h2 id="ds-title" class="h2 h2--lg">01. Definindo os padrões visuais</h2>
      <p class="lead">
        Como o cliente já possuía logomarca, cores e fontes definidas, desenvolvi um <strong>style guide no Figma</strong>
        para organizar esses elementos e estabelecer padrões de interface.
      </p>
      <p class="lead">
        Essa base orientou o desenvolvimento das telas e contribuiu para manter a consistência visual entre as diferentes
        funcionalidades e dispositivos.
      </p>
    </div>
    <PanelFigure
      src={styleGuide}
      alt="Style guide da StartDev no Figma: cores, tipografia, iconografia e grid responsivo"
      caption="Style guide construído a partir da marca já existente do cliente — o primeiro passo para padronizar a interface."
      padding={24}
      class="sg"
    />
    <div class="sec-narrow">
      <div class="note-box">
        <span class="note-mark">✓</span>
        <div>
          <div class="note-title">Sobre a persona</div>
          <p>
            O time de marketing do cliente já tinha desenvolvido uma <strong>proto-persona</strong> antes do projeto começar,
            e usei essa direção como ponto de partida um recurso pronto e legítimo, dado o prazo. Com 20 dias de prazo, essa
            foi a base: <strong>não houve pesquisa própria de persona</strong> neste projeto, e o arquivo original não está
            disponível para mostrar aqui.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Decisões -->
  <div class="band band--tint space-lg">
    <section aria-labelledby="flow-title" class="sec rv decisions-head">
      <div class="sec-narrow">
        <p class="eyebrow">Estruturação · Jornada</p>
        <h2 id="flow-title" class="h2 h2--md">02. Mapeando a jornada do estudante</h2>
        <p class="lead">
          Antes de iniciar os wireframes, desenvolvi o <strong>user flow</strong> da plataforma, organizando os caminhos de
          cadastro, acesso aos cursos, atividades, comunidade e perfil.
        </p>
        <p class="lead">
          Esse mapeamento permitiu visualizar a extensão do produto, identificar as telas necessárias e planejar o trabalho
          de acordo com o prazo disponível.
        </p>
        <div class="legend">
          <span class="pill pill--ev">Evidência</span>
          <span class="pill pill--dec">Decisão</span>
          <span class="pill pill--op">Oportunidade</span>
        </div>
      </div>
    </section>

    <div class="sec flow">
      <div class="dcard flow-card">
        <h4>User flow antes dos wireframes</h4>
        <p class="beat">
          <span class="pill pill--ev">Evidência</span>Um produto que junta cursos, atividades e fórum tem muitas telas — e o
          prazo era curto para estimar sem base.
        </p>
        <p class="beat">
          <span class="pill pill--dec">Decisão</span>Desenhei o <b>user flow primeiro</b>, mapeando a jornada de ponta a
          ponta — do cadastro e login à navegação por Cursos, Dashboard, Comunidade e Perfil — para estimar a quantidade de
          telas e o tempo de desenvolvimento antes de detalhar qualquer interface.
        </p>
        <p class="int">Intenção — <span class="serif">saber o tamanho do trabalho antes de começar a construí-lo.</span></p>
      </div>
      <PanelFigure
        src={userflow}
        alt="User flow completo da StartDev: fluxo de cadastro, login e recuperação de senha, ramificando para Cursos, Dashboard, Comunidade e Perfil"
        caption="User flow completo mapeado antes dos wireframes — a base para estimar telas e cronograma dentro do prazo."
        width={702}
        centered
        class="userflow"
      />
    </div>

    <section aria-labelledby="wire-title" class="sec rv wire">
      <div class="sec-narrow head head--sm">
        <p class="eyebrow">Estruturação · Wireframes</p>
        <h2 id="wire-title" class="h2 h2--md">03. Explorando a estrutura das interfaces</h2>
        <p class="lead">
          Com as jornadas definidas, comecei a desenvolver <strong>wireframes</strong> para organizar a hierarquia das
          informações, a navegação e os principais elementos de cada funcionalidade.
        </p>
        <p class="lead">
          Essa etapa permitiu realizar ajustes com maior agilidade e discutir as soluções com o cliente antes de avançar
          para a versão visual definitiva.
        </p>
      </div>
      <LaptopFrame
        maxWidth={840}
        src={wireframe}
        alt="Wireframe completo da tela de aula: player de vídeo, descrição, lista de módulos com progresso e comentários"
        caption="Wireframe completo da tela de aula — role dentro da tela para ver o fluxo inteiro. Estrutura, navegação, player e módulos definidos antes de qualquer decisão estética."
      />
    </section>

    <section aria-labelledby="dark-title" class="sec rv dark">
      <div class="sec-narrow head head--sm">
        <p class="eyebrow">Estruturação · Alta fidelidade</p>
        <h2 id="dark-title" class="h2">04. Refinando a experiência</h2>
        <p class="lead">
          Após a validação dos wireframes, desenvolvi as interfaces em alta fidelidade, aplicando o style guide e refinando
          os componentes e padrões de interação.
        </p>
        <p class="lead">
          Também propus uma versão em <strong>tema escuro</strong>, oferecendo uma alternativa visual para a experiência de
          aprendizagem e mantendo a consistência entre os dois temas.
        </p>
      </div>
      <div class="dcard dark-card">
        <div class="dark-text">
          <p class="beat">
            <span class="pill pill--ev">Evidência</span>O público-alvo do produto são <b>desenvolvedores</b> — que costumam
            preferir interfaces com menos luminosidade, pelo hábito das próprias ferramentas de trabalho.
          </p>
          <p class="beat">
            <span class="pill pill--dec">Decisão</span>Depois da validação do cliente, aumentei a fidelidade e <b
              >propus o dark mode</b
            > como tema de primeira classe — com tokens próprios de contraste e legibilidade, não um ajuste tardio de cor.
          </p>
          <p class="int">
            Intenção — <span class="serif">falar a língua visual de quem vai usar o produto todo dia.</span>
          </p>
        </div>
        <ThemePairs />
      </div>
    </section>
  </div>

  <!-- Gamificação -->
  <section aria-labelledby="game-title" class="sec rv space-md">
    <div class="sec-narrow head">
      <p class="eyebrow">Parte 4 · Soluções desenvolvidas</p>
      <h2 id="game-title" class="h2 h2--lg">Aprendizagem, prática e colaboração</h2>
      <p class="lead">
        As interfaces finais integram as principais funcionalidades previstas para a plataforma, organizando diferentes
        atividades dentro de uma mesma experiência.
      </p>
      <h3 class="h3 sub-h">Gamificação</h3>
      <p class="lead">
        A proposta de recompensas do cliente foi incorporada às interfaces, apresentando a pontuação e os benefícios
        associados à participação nas atividades, conclusão de cursos e interações na comunidade.
      </p>
    </div>
    <div id="cap-solucao" class="game-grid">
      {
        gamification.map((g) => (
          <div class="card game-card">
            <div class="game-title">{g.title}</div>
            <p>{g.text}</p>
          </div>
        ))
      }
    </div>
    <div class="cols-2 points">
      <PointsPreview />
      <div class="card why">
        <div class="why-label">Por que assim</div>
        <p>
          O saldo abre a tela porque é a informação que o aluno vem buscar. Logo abaixo, a distância até o próximo nível
          transforma o número em <b>meta</b>, e o extrato mostra a relação entre esforço e recompensa.
        </p>
        <p>
          Ganhos em verde e resgates em vermelho nunca aparecem sozinhos: o sinal vem sempre com o rótulo e o valor, para
          não depender de cor.
        </p>
      </div>
    </div>
  </section>

  <!-- A interface final -->
  <section aria-labelledby="ui-title" class="sec rv space-lg">
    <div class="sec-narrow head head--lg">
      <p class="eyebrow">Soluções · A interface final</p>
      <h2 id="ui-title" class="h2 h2--lg">Aula, prática e comunidade no mesmo lugar</h2>
      <dl class="sol-items">
        {
          solutions.map((item) => (
            <div>
              <dt>{item.title}</dt>
              <dd>{item.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <PhoneGallery />
    <Prototype />
  </section>

  <!-- Impacto: restrição como senioridade -->
  <div id="cap-impacto" class="band band--purple space-lg">
    <section aria-labelledby="sen-title" class="sec sec-narrow rv band-inner">
      <p class="eyebrow">Parte 5 · Entregas e resultados</p>
      <h2 id="sen-title" class="h2 h2--xl">Entregar web e mobile em 20 dias — sem parar o resto</h2>
      <p class="lead lead--last">
        A parte mais difícil deste projeto não aparece nas telas. Nos mesmos <strong>~20 dias</strong> em que entreguei as
        versões web e mobile, eu gerenciava outros projetos em paralelo e apoiava uma estagiária. Foi um exercício de
        priorização: decidir o que fazer primeiro, o que era bom o bastante, e onde apoiar a decisão em fontes já
        existentes em vez de abrir uma frente nova de pesquisa que o cronograma não comportava.
      </p>
      <div class="cols-3">
        {
          pressure.map((p) => (
            <div class="glass">
              <div class="glass-title">{p.title}</div>
              <div class="glass-text">{p.text}</div>
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <!-- Escopo entregue -->
  <section aria-labelledby="scope-title" class="sec sec-narrow rv space-lg">
    <p class="eyebrow">Entregas · Escopo entregue</p>
    <h2 id="scope-title" class="h2 h2--lg">O que foi entregue</h2>
    <p class="lead">
      O projeto resultou no desenvolvimento das <strong>experiências web e mobile</strong> da StartDev, contemplando
      pesquisa de referências, style guide, user flow, wireframes e interfaces em alta fidelidade.
    </p>
    <p class="lead">
      As soluções integraram ensino, prática, comunidade e gamificação em uma proposta visual consistente, com versões em
      tema claro e escuro.
    </p>
    <p class="lead">
      O trabalho foi concluído dentro do prazo previsto e recebeu feedback positivo do cliente sobre o resultado
      apresentado.
    </p>
    <p class="lead lead--note">
      São contagens de entregável, não métricas de resultado — a plataforma ainda não havia sido lançada no momento em que
      este case foi escrito.
    </p>
  </section>

  <!-- Retorno do cliente -->
  <section aria-labelledby="ret-title" class="sec sec-narrow rv space-xs">
    <div class="feedback">
      <p class="eyebrow" id="ret-title">Retorno do cliente</p>
      <p class="lead">
        O retorno do cliente sobre as entregas foi positivo. Como a plataforma ainda não havia sido lançada quando escrevi
        este case, não há dados de uso real nem depoimento público a citar.
      </p>
    </div>
  </section>

  <!-- Aprendizados -->
  <section aria-labelledby="ap-title" class="sec rv space-md">
    <div class="learn">
      <p class="eyebrow">Aprendizados</p>
      <h2 id="ap-title" class="h2 h2--learn">O que ficou desse projeto</h2>
      <div class="cols-2 learn-cols">
        {
          learnings.map((col) => (
            <div>
              <div class="learn-title">{col.title}</div>
              <ul>
                {col.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</CaseLayout>

<style>
  /* ---------- Vertical rhythm ---------- */
  .summary {
    margin-top: calc(104px * var(--sp, 1));
  }

  .space-xs {
    margin-top: calc(80px * var(--sp, 1));
  }

  .space-sm {
    margin-top: calc(96px * var(--sp, 1));
  }

  .space-md {
    margin-top: calc(100px * var(--sp, 1));
