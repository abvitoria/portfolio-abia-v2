---
import CaseLayout from '@/layouts/CaseLayout.astro';
import { t } from '@/data/i18n';
import CaseIntro from '@/components/case/CaseIntro.astro';
import HeroScreen from '@/components/case/startdev/HeroScreen.astro';
import LaptopFrame from '@/components/case/LaptopFrame.astro';
import PanelFigure from '@/components/case/PanelFigure.astro';
import PhoneGallery from '@/components/case/startdev/PhoneGallery.astro';
import PointsPreview from '@/components/case/startdev/PointsPreview.astro';
import Prototype from '@/components/case/startdev/Prototype.astro';
import ThemePairs from '@/components/case/startdev/ThemePairs.astro';

import cover from '@/assets/covers/capa-startdev.png';
import bench from '@/assets/case/mercado-bench.jpg';
import styleGuide from '@/assets/case/sg-clean.jpg';
import userflow from '@/assets/case/userflow.jpg';
import wireframe from '@/assets/case/wireframe-aula.png';

const summary = [
  {
    href: '#cap-descoberta',
    mark: '☍',
    title: t('Ensino + comunidade + gamificação', 'Learning + community + gamification'),
    text: t('Uma proposta ambiciosa de negócio para virar uma interface única.', 'An ambitious business proposal to turn into a single interface.'),
    cta: t('Ver o desafio →', 'See the challenge →'),
  },
  {
    href: '#cap-descoberta',
    mark: '20d',
    title: t('Prazo real e apertado', 'A real, tight deadline'),
    text: t('Web e mobile em ~20 dias, com pesquisa própria limitada.', 'Web and mobile in ~20 days, with limited first-hand research.'),
    cta: t('Entender a restrição →', 'Understand the constraint →'),
  },
  {
    href: '#cap-decisoes',
    mark: '→',
    title: t('A direção tomada', 'The direction taken'),
    text: t('Estrutura antes da estética: fluxo, wireframes, style guide e dark mode.', 'Structure before aesthetics: flow, wireframes, style guide and dark mode.'),
    cta: t('Ver as decisões →', 'See the decisions →'),
  },
];

const challenge = [
  { n: t('3 em 1', '3 in 1'), text: t('Ensino, comunidade e gamificação num único produto.', 'Learning, community and gamification in a single product.') },
  { n: t('~20 dias', '~20 days'), text: t('Para entregar as versões web e mobile.', 'To deliver the web and mobile versions.') },
  { n: t('↯'), text: t('Sem pesquisa própria de usuário no início do projeto.', 'No first-hand user research at the start of the project.') },
];

const steps = [
  {
    title: t('Revisão do documento de especificações', 'Review of the specification document'),
    text: t('Li a fundo o que o cliente já havia definido de negócio e escopo, para não recomeçar do zero o que já estava resolvido.', 'I read in depth what the client had already defined for business and scope, so as not to restart from scratch what was already solved.'),
  },
  {
    title: t('Roteiro de entrevista', 'Interview script'),
    text: t('Montei um roteiro no Google Docs para conduzir a conversa com o cliente com foco, não uma reunião aberta, mas perguntas dirigidas às decisões de design.', 'I put together a script in Google Docs to keep the conversation with the client focused — not an open-ended meeting, but questions aimed at design decisions.'),
  },
  {
    title: t('Entrevista com o cliente', 'Client interview'),
    text: t('Levantei as expectativas de negócio e visuais, perguntando explicitamente sobre <strong>paleta de cores já existente</strong> e <strong>referências visuais</strong> que ele admirava o que evitou retrabalho estético mais à frente.', 'I gathered business and visual expectations, asking explicitly about the <strong>existing color palette</strong> and the <strong>visual references</strong> the client admired — which avoided aesthetic rework later on.'),
  },
];

const gamification = [
  { title: t('Pontos por ajudar', 'Points for helping'), text: t('Quem apoia outros usuários na comunidade acumula pontos.', 'Those who help other users in the community earn points.') },
  { title: t('Troca por cursos', 'Exchange for courses'), text: t('Pontos viram cursos ou descontos — valor concreto de volta.', 'Points turn into courses or discounts — concrete value in return.') },
  {
    title: t('Recompensa por progresso', 'Rewards for progress'),
    text: t('Completar cursos, avaliar aulas, responder atividades e interagir em fóruns rende pontos.', 'Completing courses, rating lessons, answering activities and interacting in forums earns points.'),
  },
  { title: t('Metas visíveis', 'Visible goals'), text: t('Pontuação e progresso no curso atual sempre à vista, dando sensação de avanço.', 'Score and progress in the current course always in view, giving a sense of advancement.') },
];

const solutions = [
  {
    title: t('Cursos e atividades', 'Courses and activities'),
    text: t('Uma experiência para acessar conteúdos, acompanhar módulos e realizar exercícios, com informações de progresso ao longo da jornada.', 'An experience for accessing content, following modules and doing exercises, with progress information throughout the journey.'),
  },
  {
    title: t('Comunidade', 'Community'),
    text: t('Um espaço dedicado à interação entre estudantes, permitindo criar discussões, compartilhar dúvidas e colaborar com outros participantes.', 'A space dedicated to interaction between students, for starting discussions, sharing questions and collaborating with other participants.'),
  },
  {
    title: t('Experiência mobile', 'Mobile experience'),
    text: t('Adaptação das principais funcionalidades para dispositivos móveis, preservando a organização das informações e os padrões visuais da plataforma.', 'The main features adapted for mobile devices, preserving the platform’s information organization and visual patterns.'),
  },
];

const pressure = [
  { title: t('Priorização', 'Prioritization'), text: t('Estrutura antes da estética, para não desperdiçar dias em retrabalho.', 'Structure before aesthetics, so no days were wasted on rework.') },
  { title: t('Reaproveitamento', 'Reuse'), text: t('Proto-persona e marca do cliente usadas como ponto de partida legítimo.', 'The client’s proto-persona and brand used as a legitimate starting point.') },
  { title: t('Liderança', 'Leadership'), text: t('Manter outros projetos e apoiar uma estagiária sem travar a entrega.', 'Keeping other projects running and supporting an intern without blocking delivery.') },
];

const learnings = [
  {
    title: t('O que funcionou', 'What worked'),
    items: [
      t('Fazer o user flow antes de tudo permitiu estimar telas e cortar escopo cedo — foi o que fez os 20 dias caberem.', 'Doing the user flow before anything else made it possible to estimate screens and cut scope early — that is what made the 20 days fit.'),
      t('Trabalhar dentro da marca do cliente, sem propor identidade nova, poupou dias de alinhamento visual.', 'Working within the client’s brand, without proposing a new identity, saved days of visual alignment.'),
    ],
  },
  {
    title: t('O que eu faria diferente', 'What I would do differently'),
    items: [
      t('Reservar espaço para pesquisa própria de usuário e validação com teste, mesmo que enxuta, defendendo isso já na negociação do prazo.', 'Make room for first-hand user research and test-based validation, even if lean, advocating for it as early as the deadline negotiation.'),
      t('Acompanhar o produto após o lançamento para fechar o ciclo com dados reais de uso.', 'Follow the product after launch to close the loop with real usage data.'),
    ],
  },
];
---

<CaseLayout
  title="StartDev — Uma experiência de aprendizagem que conecta teoria, prática e comunidade"
  description="Ensino, comunidade colaborativa e gamificação num só produto: a interface web e mobile da StartDev, desenhada em cerca de 20 dias."
  image={cover.src}
  chapters={[
    { id: 'cap-contexto', label: t('Contexto', 'Context') },
    { id: 'cap-descoberta', label: t('Investigação', 'Research') },
    { id: 'cap-decisoes', label: t('Estruturação', 'Structuring') },
    { id: 'cap-solucao', label: t('Soluções', 'Solutions') },
    { id: 'cap-impacto', label: t('Entregas', 'Delivery') },
  ]}
  ambient
  showLang
  cta={{ title: t('Tem um fluxo assim no seu produto?', 'Have a flow like this in your product?') }}
>
  <CaseIntro
    badges={[
      { label: 'UX/UI CASE', color: '#0B7C8F' },
      { label: t('Edtech · Comunidade', 'Edtech · Community'), color: '#561589' },
      { label: 'WEB + MOBILE', color: '#6E3FC8' },
    ]}
    eyebrow="StartDev · Product design · UX/UI · Edtech"
    title={t(
      'Uma experiência de aprendizagem que conecta <span class="serif">teoria, prática e comunidade</span>',
      'A learning experience that connects <span class="serif">theory, practice and community</span>',
    )}
    lead={t(
      'A StartDev é uma plataforma de ensino de programação que combina aulas, exercícios, interação entre estudantes e um sistema de gamificação, no qual a participação e o progresso podem gerar <strong>pontos e recompensas</strong>.',
      'StartDev is a programming education platform that combines lessons, exercises, student interaction and a gamification system in which participation and progress can earn <strong>points and rewards</strong>.',
    )}
    facts={[
      { label: t('Papel', 'Role'), value: 'UX/UI Designer' },
      { label: t('Plataformas', 'Platforms'), value: t('Web e mobile', 'Web and mobile') },
      { label: t('Duração', 'Duration'), value: t('Aproximadamente 20 dias', 'About 20 days') },
      { label: t('Ferramenta de design', 'Design tool'), tools: [{ label: 'Figma', icon: 'figma' }] },
      { label: t('Temas', 'Themes'), value: t('Claro &amp; escuro', 'Light &amp; dark') },
    ]}
  >
    <HeroScreen />
    <div class="card deadline">
      <span class="n">20</span>
      <span data-en="days, from brief<br />to final delivery">dias, do briefing<br />à entrega final</span>
    </div>
  </CaseIntro>

  <!-- Resumo / índice -->
  <section id="cap-contexto" aria-labelledby="resumo-title" class="sec rv summary">
    <h2 data-en="Case summary" id="resumo-title" class="sr-only">Resumo do case</h2>
    <div class="cols-3">
      {
        summary.map((s) => (
          <a href={s.href} class="card card--link summary-card">
            <span class="mark">{s.mark}</span>
            <div class="summary-title" data-en={s.title.en} set:html={s.title.pt} />
            <p>
              <span data-en={s.text.en} set:html={s.text.pt} /> <span class="more" data-en={s.cta.en} set:html={s.cta.pt} />
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Contexto -->
  <section aria-labelledby="ctx-title" class="sec sec-narrow rv space-sm">
    <p data-en="Part 1 · Context and challenge" class="eyebrow">Parte 1 · Contexto e desafio</p>
    <h2 data-en="Getting to know the project" id="ctx-title" class="h2 h2--lg">Conhecendo o projeto</h2>
    <p data-en="<strong>StartDev</strong>’s proposal was to offer a learning experience that went beyond traditional lessons, encouraging practice and collaboration between students." class="lead">
      A proposta da <strong>StartDev</strong> era oferecer uma experiência de aprendizagem que fosse além das aulas
      tradicionais, incentivando a prática e a colaboração entre estudantes.
    </p>
    <p data-en="The client had already defined the main features, the visual identity and the rewards system. My responsibility was to structure those ideas into a <strong>consistent digital experience for web and mobile</strong>." class="lead">
      O cliente já possuía uma definição das principais funcionalidades, da identidade visual e do sistema de
      recompensas. Minha responsabilidade foi estruturar essas ideias em uma <strong
        >experiência digital consistente para web e mobile</strong
      >.
    </p>
  </section>

  <!-- O desafio real -->
  <div id="cap-descoberta" class="band band--purple space-sm">
    <section aria-labelledby="prob-title" class="sec sec-narrow rv band-inner">
      <p data-en="Context · The challenge" class="eyebrow">Contexto · O desafio</p>
      <h2 data-en="The challenge" id="prob-title" class="h2 h2--xl">O desafio</h2>
      <p data-en="Organizing courses, hands-on activities, community and gamification within intuitive navigation, so that students could track their progress and reach the different features easily." class="lead">
        Organizar cursos, atividades práticas, comunidade e gamificação dentro de uma navegação intuitiva, permitindo que
        os estudantes acompanhassem seu progresso e acessassem as diferentes funcionalidades com facilidade.
      </p>
      <p data-en="The project also had a deadline of <strong>about 20 days</strong>, which called for planning and validation throughout the development of the interfaces." class="lead lead--last">
        O projeto também tinha um prazo de <strong>aproximadamente 20 dias</strong>, exigindo planejamento e validações ao
        longo do desenvolvimento das interfaces.
      </p>
      <div class="cols-3">
        {
          challenge.map((c) => (
            <div class="glass">
              <div class="glass-n" data-en={c.n.en} set:html={c.n.pt} />
              <div class="glass-text" data-en={c.text.en} set:html={c.text.pt} />
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <!-- Como cheguei na solução -->
  <section aria-labelledby="proc-title" class="sec sec-narrow rv space-lg">
    <p data-en="Part 2 · Research and planning" class="eyebrow">Parte 2 · Investigação e planejamento</p>
    <h2 data-en="Understanding the client’s proposal" id="proc-title" class="h2 h2--lg">Entendendo a proposta do cliente</h2>
    <p data-en="I started by reviewing the project documentation and identifying questions about features, business rules and visual expectations. I organized a list of questions in Google Docs and talked with the client to clarify those points and better understand the expected direction." class="lead">
      Comecei revisando a documentação do projeto e identificando dúvidas sobre funcionalidades, regras de negócio e
      expectativas visuais. Organizei um roteiro de perguntas no Google Docs e conversei com o cliente para esclarecer
      esses pontos e compreender melhor o direcionamento esperado.
    </p>
    <p data-en="I also used as a reference a <strong>proto-persona</strong> already developed by the Marketing team." class="lead lead--last">
      Também utilizei como referência uma <strong>proto-persona</strong> já desenvolvida pelo time de Marketing.
    </p>
    <div class="rows">
      {
        steps.map((s, i) => (
          <div class="num-row">
            <span class="num-row__n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <div class="row-title" data-en={s.title.en} set:html={s.title.pt} />
              <div class="row-text" data-en={s.text.en} set:html={s.text.pt} />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Mercado -->
  <section aria-labelledby="mkt-title" class="sec rv space-md">
    <div class="sec-narrow head">
      <p data-en="Research · Market" class="eyebrow">Investigação · Mercado</p>
      <h2 data-en="Researching references" id="mkt-title" class="h2 h2--lg">Pesquisando referências</h2>
      <p data-en="I ran an analysis of <strong>direct and indirect competitors</strong>, bringing together learning platforms, developer communities, international products and gamification references." class="lead">
        Realizei uma análise de <strong>concorrentes diretos e indiretos</strong>, reunindo plataformas de ensino,
        comunidades de desenvolvedores, produtos internacionais e referências de gamificação.
      </p>
      <p data-en="I organized this research in Google Sheets, identifying navigation solutions, content presentation and interaction features that could contribute to StartDev’s development." class="lead">
        Organizei essa pesquisa no Google Sheets, identificando soluções de navegação, apresentação de conteúdos e
        recursos de interação que poderiam contribuir para o desenvolvimento da StartDev.
      </p>
    </div>
    <PanelFigure
      src={bench}
      alt="Estudo comparativo de concorrentes organizado por Home, Cursos e Perfil, com prints reais das plataformas de referência"
      caption={t(
        'Painel de referências de concorrentes, agrupado pelas telas-chave do produto — a base visual e funcional que sustentou as decisões seguintes.',
        'A board of competitor references, grouped by the product’s key screens — the visual and functional basis for the decisions that followed.',
      )}
      width={682}
    />
  </section>

  <!-- Style guide e persona -->
  <section id="cap-decisoes" aria-labelledby="ds-title" class="sec rv space-lg">
    <div class="sec-narrow head">
      <p data-en="Part 3 · Structuring and design" class="eyebrow">Parte 3 · Estruturação e design</p>
      <h2 data-en="01. Defining the visual patterns" id="ds-title" class="h2 h2--lg">01. Definindo os padrões visuais</h2>
      <p data-en="Since the client already had a logo, colors and fonts defined, I developed a <strong>style guide in Figma</strong> to organize those elements and establish interface patterns." class="lead">
        Como o cliente já possuía logomarca, cores e fontes definidas, desenvolvi um <strong>style guide no Figma</strong>
        para organizar esses elementos e estabelecer padrões de interface.
      </p>
      <p data-en="This foundation guided the development of the screens and helped keep visual consistency across features and devices." class="lead">
        Essa base orientou o desenvolvimento das telas e contribuiu para manter a consistência visual entre as diferentes
        funcionalidades e dispositivos.
      </p>
    </div>
    <PanelFigure
      src={styleGuide}
      alt="Style guide da StartDev no Figma: cores, tipografia, iconografia e grid responsivo"
      caption={t(
        'Style guide construído a partir da marca já existente do cliente — o primeiro passo para padronizar a interface.',
        'A style guide built from the client’s existing brand — the first step toward a standardized interface.',
      )}
      padding={24}
      class="sg"
    />
    <div class="sec-narrow">
      <div class="note-box">
        <span class="note-mark">✓</span>
        <div>
          <div data-en="About the persona" class="note-title">Sobre a persona</div>
          <p data-en="The client’s marketing team had already developed a <strong>proto-persona</strong> before the project started, and I used that direction as a starting point — a ready, legitimate resource given the deadline. With 20 days, that was the foundation: <strong>there was no first-hand persona research</strong> in this project, and the original file is not available to show here.">
            O time de marketing do cliente já tinha desenvolvido uma <strong>proto-persona</strong> antes do projeto começar,
            e usei essa direção como ponto de partida um recurso pronto e legítimo, dado o prazo. Com 20 dias de prazo, essa
            foi a base: <strong>não houve pesquisa própria de persona</strong> neste projeto, e o arquivo original não está
            disponível para mostrar aqui.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Decisões -->
  <div class="band band--tint space-lg">
    <section aria-labelledby="flow-title" class="sec rv decisions-head">
      <div class="sec-narrow">
        <p data-en="Structuring · Journey" class="eyebrow">Estruturação · Jornada</p>
        <h2 data-en="02. Mapping the student journey" id="flow-title" class="h2 h2--md">02. Mapeando a jornada do estudante</h2>
        <p data-en="Before starting the wireframes, I developed the platform’s <strong>user flow</strong>, organizing the paths for sign-up, access to courses, activities, community and profile." class="lead">
          Antes de iniciar os wireframes, desenvolvi o <strong>user flow</strong> da plataforma, organizando os caminhos de
          cadastro, acesso aos cursos, atividades, comunidade e perfil.
        </p>
        <p data-en="This mapping made it possible to see the full extent of the product, identify the screens needed and plan the work according to the available deadline." class="lead">
          Esse mapeamento permitiu visualizar a extensão do produto, identificar as telas necessárias e planejar o trabalho
          de acordo com o prazo disponível.
        </p>
        <div class="legend">
          <span data-en="Evidence" class="pill pill--ev">Evidência</span>
          <span data-en="Decision" class="pill pill--dec">Decisão</span>
          <span data-en="Opportunity" class="pill pill--op">Oportunidade</span>
        </div>
      </div>
    </section>

    <div class="sec flow">
      <div class="dcard flow-card">
        <h4 data-en="User flow before wireframes">User flow antes dos wireframes</h4>
        <p data-en="<span class=&quot;pill pill--ev&quot;>Evidence</span>A product that brings together courses, activities and a forum has many screens — and the deadline was too short to estimate without a basis." class="beat">
          <span class="pill pill--ev">Evidência</span>Um produto que junta cursos, atividades e fórum tem muitas telas — e o
          prazo era curto para estimar sem base.
        </p>
        <p data-en="<span class=&quot;pill pill--dec&quot;>Decision</span>I designed the <b>user flow first</b>, mapping the journey end to end — from sign-up and login to navigating Courses, Dashboard, Community and Profile — to estimate the number of screens and development time before detailing any interface." class="beat">
          <span class="pill pill--dec">Decisão</span>Desenhei o <b>user flow primeiro</b>, mapeando a jornada de ponta a
          ponta — do cadastro e login à navegação por Cursos, Dashboard, Comunidade e Perfil — para estimar a quantidade de
          telas e o tempo de desenvolvimento antes de detalhar qualquer interface.
        </p>
        <p data-en="Intent — <span class=&quot;serif&quot;>know the size of the work before starting to build it.</span>" class="int">Intenção — <span class="serif">saber o tamanho do trabalho antes de começar a construí-lo.</span></p>
      </div>
      <PanelFigure
        src={userflow}
        alt="User flow completo da StartDev: fluxo de cadastro, login e recuperação de senha, ramificando para Cursos, Dashboard, Comunidade e Perfil"
        caption={t(
          'User flow completo mapeado antes dos wireframes — a base para estimar telas e cronograma dentro do prazo.',
          'The complete user flow mapped before the wireframes — the basis for estimating screens and the schedule within the deadline.',
        )}
        width={702}
        centered
        class="userflow"
      />
    </div>

    <section aria-labelledby="wire-title" class="sec rv wire">
      <div class="sec-narrow head head--sm">
        <p data-en="Structuring · Wireframes" class="eyebrow">Estruturação · Wireframes</p>
        <h2 data-en="03. Exploring the structure of the interfaces" id="wire-title" class="h2 h2--md">03. Explorando a estrutura das interfaces</h2>
        <p data-en="With the journeys defined, I started developing <strong>wireframes</strong> to organize the information hierarchy, navigation and the main elements of each feature." class="lead">
          Com as jornadas definidas, comecei a desenvolver <strong>wireframes</strong> para organizar a hierarquia das
          informações, a navegação e os principais elementos de cada funcionalidade.
        </p>
        <p data-en="This stage made it possible to adjust quickly and discuss solutions with the client before moving on to the final visual version." class="lead">
          Essa etapa permitiu realizar ajustes com maior agilidade e discutir as soluções com o cliente antes de avançar
          para a versão visual definitiva.
        </p>
      </div>
      <LaptopFrame
        maxWidth={840}
        src={wireframe}
        alt="Wireframe completo da tela de aula: player de vídeo, descrição, lista de módulos com progresso e comentários"
        caption={t(
          'Wireframe completo da tela de aula — role dentro da tela para ver o fluxo inteiro. Estrutura, navegação, player e módulos definidos antes de qualquer decisão estética.',
          'Complete wireframe of the lesson screen — scroll inside the screen to see the whole flow. Structure, navigation, player and modules defined before any aesthetic decision.',
        )}
      />
    </section>

    <section aria-labelledby="dark-title" class="sec rv dark">
      <div class="sec-narrow head head--sm">
        <p data-en="Structuring · High fidelity" class="eyebrow">Estruturação · Alta fidelidade</p>
        <h2 data-en="04. Refining the experience" id="dark-title" class="h2">04. Refinando a experiência</h2>
        <p data-en="After the wireframes were validated, I developed the interfaces in high fidelity, applying the style guide and refining components and interaction patterns." class="lead">
          Após a validação dos wireframes, desenvolvi as interfaces em alta fidelidade, aplicando o style guide e refinando
          os componentes e padrões de interação.
        </p>
        <p data-en="I also proposed a <strong>dark theme</strong> version, offering a visual alternative for the learning experience while keeping both themes consistent." class="lead">
          Também propus uma versão em <strong>tema escuro</strong>, oferecendo uma alternativa visual para a experiência de
          aprendizagem e mantendo a consistência entre os dois temas.
        </p>
      </div>
      <div class="dcard dark-card">
        <div class="dark-text">
          <p data-en="<span class=&quot;pill pill--ev&quot;>Evidence</span>The product’s target audience is <b>developers</b> — who tend to prefer lower-luminance interfaces, out of habit from their own work tools." class="beat">
            <span class="pill pill--ev">Evidência</span>O público-alvo do produto são <b>desenvolvedores</b> — que costumam
            preferir interfaces com menos luminosidade, pelo hábito das próprias ferramentas de trabalho.
          </p>
          <p data-en="<span class=&quot;pill pill--dec&quot;>Decision</span>After the client’s validation, I raised the fidelity and <b>proposed dark mode</b> as a first-class theme — with its own contrast and legibility tokens, not a late color tweak." class="beat">
