---
import { Image } from 'astro:assets';
import CaseLayout from '@/layouts/CaseLayout.astro';
import { t } from '@/data/i18n';
import CaseIntro from '@/components/case/CaseIntro.astro';
import BeforeAfter from '@/components/case/trade/BeforeAfter.astro';
import CsdColumn from '@/components/case/trade/CsdColumn.astro';
import LogHead from '@/components/case/trade/LogHead.astro';
import PersonaCard from '@/components/case/trade/PersonaCard.astro';
import ProcessShot from '@/components/case/trade/ProcessShot.astro';
import StoreReview from '@/components/case/trade/StoreReview.astro';

import cover from '@/assets/covers/capa-trade.png';
import telaLogin from '@/assets/trade/tela-login.png';
import telaCadastro from '@/assets/trade/tela-cadastro.png';
import telaAjuste from '@/assets/trade/tela-ajuste.png';
import workshop5 from '@/assets/trade/workshop-5.jpg';
import workshop1 from '@/assets/trade/workshop-1-blurred.png';
import matrizCsd from '@/assets/trade/matriz-csd.jpg';
import wireframes from '@/assets/trade/wireframes.png';
import fluxo from '@/assets/trade/fluxo.jpg';
import circulo from '@/assets/icons/circulo.png';
import raio from '@/assets/icons/raio.png';
import estrela from '@/assets/icons/estrela.png';

const summary = [
  {
    href: '#cap-descoberta',
    mark: '+30',
    title: t('Telas de cadastro', 'Sign-up screens'),
    text: t('Um fluxo exaustivo que afastava mais do que convertia.', 'An exhausting flow that drove people away more than it converted.'),
    cta: t('Ver a descoberta →', 'See the discovery →'),
  },
  {
    href: '#cap-descoberta',
    mark: '☍',
    title: t('Conhecimento fragmentado', 'Fragmented knowledge'),
    text: t('Informação dispersa entre as áreas — um “telefone sem fio”.', 'Information scattered across teams — a game of “telephone”.'),
    cta: t('Entender o problema →', 'Understand the problem →'),
  },
  {
    href: '#cap-decisoes',
    mark: '→',
    title: t('A direção tomada', 'The direction taken'),
    text: t(
      'Cadastro em duas etapas, fluxo documentado e um motivo pra voltar ao app.',
      'A two-stage sign-up, a documented flow and a reason to come back to the app.',
    ),
    cta: t('Ver as decisões →', 'See the decisions →'),
  },
];

const problemStats = [
  { mark: '30+', text: t('telas num fluxo linear e exaustivo, com alta desistência.', 'screens in a linear, exhausting flow, with high drop-off.') },
  {
    mark: '✎',
    text: t(
      'telas ainda com <strong>Lorem Ipsum em produção</strong>, passando impressão de produto inacabado.',
      'screens still showing <strong>Lorem Ipsum in production</strong>, making the product feel unfinished.',
    ),
  },
  {
    mark: '↯',
    text: t(
      'nenhuma fonte única de verdade — a informação do produto vivia dispersa entre as áreas.',
      'no single source of truth — product information was scattered across teams.',
    ),
  },
];

const sources = [
  {
    title: t('Reunião com o P.O. — regras de negócio', 'Meeting with the PO — business rules'),
    text: t(
      'Pedi o propósito de cada dado do fluxo: por que ele é solicitado e qual regra o sustenta. Muitos campos existiam por inércia, sem ninguém ter revisitado o conjunto.',
      'I asked for the purpose of every piece of data in the flow: why it is requested and which rule supports it. Many fields existed out of inertia, and no one had revisited the whole set.',
    ),
  },
  {
    title: t('Desenvolvimento — dados de comportamento', 'Development — behavioral data'),
    text: t(
      'Levantei com o time de dev o comportamento real: tela com mais erros, onde as pessoas clicavam, tempo gasto por tela e falhas recorrentes — a evidência de onde o fluxo travava.',
      'With the dev team, I gathered real behavior: the screen with the most errors, where people clicked, time spent per screen and recurring failures — the evidence of where the flow got stuck.',
    ),
  },
  {
    title: t('Marketing — quem é o usuário', 'Marketing — who the user is'),
    text: t(
      'O time de Marketing detinha o conhecimento acumulado sobre o varejista atendido. Foi dessa base que construí a persona — uma representação inicial, não uma pesquisa direta com usuário final.',
      'The Marketing team held the accumulated knowledge about the retailers served. I built the persona from that base — an initial representation, not direct research with end users.',
    ),
  },
  {
    title: t('Suporte — reclamações recorrentes', 'Support — recurring complaints'),
    text: t(
      'Levantei a reclamação nº 1, o que o app não resolvia e o que o usuário esperava do cadastro — o termômetro qualitativo do problema, vindo de quem fala com o cliente todos os dias.',
      'I gathered the #1 complaint, what the app failed to solve and what users expected from sign-up — the qualitative gauge of the problem, coming from the people who talk to customers every day.',
    ),
  },
];

const questions = [
  t('Quais dados são realmente essenciais no cadastro?', 'Which data is truly essential at sign-up?'),
  t('Quem é, de fato, o usuário do produto?', 'Who, in fact, is the product’s user?'),
  t('Qual é a reclamação nº 1 no suporte?', 'What is the #1 complaint at support?'),
];

const csd = [
  {
    label: t('Certezas', 'Certainties'),
    bar: '#4A9434',
    dot: '#4A9434',
    tint: '#D6F4C9',
    items: [
      t('O cadastro tem 30+ telas e gera alta desistência.', 'Sign-up has 30+ screens and high drop-off.'),
      t('O design foi feito por devs, sem processo de UX/UI.', 'The design was made by devs, with no UX/UI process.'),
      t('Há telas em produção com Lorem Ipsum.', 'There are screens in production with Lorem Ipsum.'),
    ],
  },
  {
    label: t('Suposições', 'Assumptions'),
    bar: '#0B7C8F',
    dot: '#5B9CC5',
    tint: '#CFE4EE',
    items: [
      t('A maioria quer explorar o app antes de pedir crédito.', 'Most users want to explore the app before applying for credit.'),
      t('Dividir o cadastro em etapas reduz o abandono.', 'Splitting sign-up into stages reduces drop-off.'),
      t('Faltam funcionalidades que tragam o usuário de volta.', 'Features that bring users back are missing.'),
    ],
  },
  { label: t('Dúvidas', 'Doubts'), bar: 'var(--rose)', dot: 'var(--rose)', tint: 'var(--rose-lighter)', items: questions },
];

const findings = [
  {
    title: t('Excesso de dados solicitados', 'Too much data requested'),
    text: t('Boa parte sem propósito claro para o usuário.', 'Much of it with no clear purpose for the user.'),
  },
  {
    title: t('Cadastro extenso — 30+ telas', 'Long sign-up — 30+ screens'),
    text: t('Demorado e cansativo, empurrando para a desistência.', 'Slow and tiring, pushing people to give up.'),
  },
  {
    title: t('Interesse inicial diferente do esperado', 'Initial interest different from expected'),
    text: t(
      'A maioria queria explorar o app e entender como funcionava antes de focar no pedido de crédito.',
      'Most wanted to explore the app and understand how it worked before focusing on the credit application.',
    ),
  },
  {
    title: t('Poucas funcionalidades recorrentes', 'Few recurring features'),
    text: t('Faltava motivo para voltar ao app fora do pedido de crédito.', 'There was no reason to return to the app beyond the credit application.'),
  },
  {
    title: t('Textos vazios (Lorem Ipsum)', 'Empty copy (Lorem Ipsum)'),
    text: t('Placeholder em produção minava a percepção de qualidade.', 'Placeholder text in production undermined the perception of quality.'),
  },
];

/** Decisions 02–05 (01 is the featured row with the screen). */
const flowDecisions = [
  {
    n: '02',
    title: t('Otimização de campos', 'Field optimization'),
    text: t(
      'Só o <b>essencial</b> permaneceu — todo campo sem regra de negócio por trás foi cortado.',
      'Only the <b>essentials</b> stayed — every field without a business rule behind it was cut.',
    ),
    evidence: t('campos sem propósito, confirmado com o P.O.', 'fields with no purpose, confirmed with the PO'),
    intent: t('cada campo com um motivo real de existir', 'every field with a real reason to exist'),
  },
  {
    n: '03',
    title: t('Textos e ícones acessíveis', 'Accessible copy and icons'),
    text: t(
      '<b>Linguagem simples</b> e ícones reconhecíveis no lugar de rótulos ambíguos.',
      '<b>Plain language</b> and recognizable icons instead of ambiguous labels.',
    ),
    evidence: t('Lorem Ipsum em produção, linguagem confusa', 'Lorem Ipsum in production, confusing language'),
    intent: t('entender a tela sem esforço', 'understand the screen effortlessly'),
  },
  {
    n: '04',
    title: t('Validação antecipada', 'Early validation'),
    text: t(
      '<b>Validação do contato</b> logo no começo do fluxo, e não na última tela.',
      '<b>Contact validation</b> right at the start of the flow, not on the last screen.',
    ),
    evidence: t('erros de contato só apareciam no fim', 'contact errors only showed up at the end'),
    intent: t('falhar cedo, não no fim', 'fail early, not at the end'),
  },
  {
    n: '05',
    title: t('Documentação do fluxo', 'Flow documentation'),
    text: t(
      '<b>Documentação ponta a ponta</b> como fonte única de verdade para produto e desenvolvimento.',
      '<b>End-to-end documentation</b> as a single source of truth for product and development.',
    ),
    evidence: t('fluxo feito por devs sem UX', 'flow built by devs without UX'),
    intent: t('acabar com o retrabalho e alinhar o time', 'end rework and align the team'),
  },
];

const featureDecisions = [
  {
    n: '06',
    title: t('Acompanhamento de limite', 'Credit limit tracking'),
    text: t(
      '<b>Limite utilizado e disponível</b> sempre visível na home, com ajuste de percentual.',
      '<b>Used and available limit</b> always visible on the home screen, with percentage adjustment.',
    ),
    evidence: t(
      'sem visão do crédito, nada motivava abrir o app entre compras',
      'with no view of their credit, nothing motivated opening the app between purchases',
    ),
  },
  {
    n: '07',
    title: t('Boletos direto no app', 'Payment slips in the app'),
    text: t('<b>Aba de boletos</b> dentro do próprio app, sem passar pelo desktop.', 'A <b>payment slips tab</b> inside the app, no desktop needed.'),
    evidence: t('boletos só existiam via desktop', 'payment slips were only available on desktop'),
  },
  {
    n: '08',
    title: t('Configurações de dados básicos', 'Basic data settings'),
    text: t(
      '<b>Área de configurações</b> pra conferir e ajustar os dados quando quiser.',
      'A <b>settings area</b> to review and update data at any time.',
    ),
    evidence: t('dados só editáveis no cadastro inicial', 'data was only editable during the initial sign-up'),
  },
  {
    n: '09',
    title: t('FAQ para suporte rápido', 'FAQ for quick support'),
    text: t('<b>FAQ no app</b>, sem depender de atendimento humano.', 'An <b>in-app FAQ</b>, without depending on human support.'),
    evidence: t('dúvidas recorrentes sobrecarregavam o Suporte', 'recurring questions overloaded Support'),
  },
];

const fronts = [
  {
    icon: circulo,
    tint: 'rgba(158, 108, 239, 0.14)',
    title: t('Otimizar o cadastro', 'Optimize sign-up'),
    text: t('Reduzir fricção e abandono no fluxo.', 'Reduce friction and drop-off in the flow.'),
  },
  {
    icon: raio,
    tint: 'rgba(176, 213, 240, 0.16)',
    title: t('Documentar telas e fluxo', 'Document screens and flow'),
    text: t('Acabar com o “telefone sem fio” no time.', 'End the game of “telephone” within the team.'),
  },
  {
    icon: estrela,
    tint: 'rgba(84, 206, 226, 0.16)',
    title: t('Trazer insights de novas funcionalidades', 'Bring insights for new features'),
    text: t('Dar um motivo para voltar ao app.', 'Give people a reason to return to the app.'),
  },
];

const screens = [
  {
    src: telaCadastro,
    alt: 'Primeira etapa do cadastro, com o essencial para começar',
    tint: 'rgba(176, 213, 240, 0.16)',
    title: t('Cadastro redesenhado', 'Redesigned sign-up'),
    text: t(
      'Uma jornada organizada em duas etapas, separando o acesso inicial ao aplicativo da solicitação de crédito.',
      'A journey organized into two stages, separating initial access to the app from the credit application.',
    ),
  },
  {
    src: telaAjuste,
    alt: 'Nova funcionalidade de acompanhamento e ajuste do limite',
    tint: '#E7F5EF',
    title: t('Acompanhamento financeiro', 'Financial tracking'),
    text: t(
      'Novas interfaces para consultar limites e boletos diretamente pelo aplicativo.',
      'New interfaces to check limits and payment slips directly in the app.',
    ),
  },
  {
    title: t('Navegação e suporte', 'Navigation and support'),
    text: t(
      'Melhorias na organização das informações, configurações de conta e acesso a dúvidas frequentes.',
      'Improvements to information organization, account settings and access to frequently asked questions.',
    ),
  },
];

const changes = [
  {
    before: t('Cadastro linear de 30+ telas, tudo de uma vez.', 'A linear 30+ screen sign-up, all at once.'),
    after: t('Duas etapas, com acesso rápido ao app já no início.', 'Two stages, with quick access to the app right from the start.'),
  },
  {
    before: t('Dados pedidos sem propósito claro; erros só no fim.', 'Data requested with no clear purpose; errors only at the end.'),
    after: t(
      'Só o essencial, cada campo justificado, com validação antecipada.',
      'Only the essentials, every field justified, with early validation.',
    ),
  },
  {
    before: t(
      'Conhecimento disperso — “telefone sem fio”, Lorem Ipsum em produção.',
      'Scattered knowledge — a game of “telephone”, Lorem Ipsum in production.',
    ),
    after: t(
      'Fluxo documentado de ponta a ponta, com conteúdo real e acessível.',
      'An end-to-end documented flow, with real and accessible content.',
    ),
  },
  {
    before: t('App servia só ao fluxo de aprovação de crédito.', 'The app only served the credit approval flow.'),
    after: t(
      'Motivo de uso recorrente: limite, boletos, configurações e FAQ.',
      'Reasons for recurring use: limit, payment slips, settings and FAQ.',
    ),
  },
];

const reviews = [
  {
    title: t('Súper fácil', 'Super easy'),
    author: 'Ana_73',
    text: t(
      'Aplicativo muito intuitivo e fácil de usar, top! Parabéns Trademaster, ajudando o varejo a vender mais!',
      'Very intuitive and easy-to-use app, awesome! Congrats Trademaster, helping retail sell more!',
    ),
  },
  { title: t('Showww', 'Amazing'), author: 'Malmelo', text: t('Super fácil e intuitivo.', 'Super easy and intuitive.') },
  {
    title: t('Muito prático', 'Very practical'),
    author: 'Leo_alpha',
    text: t('Excelente aplicativo. Cumpre tudo aquilo que promete.', 'Excellent app. It delivers everything it promises.'),
  },
  {
    title: t('Muito bom!', 'Very good!'),
    author: 'Pedro Igoa',
    text: t(
      'Extremamente intuitivo, fácil de usar e muito bom serviço prestado!',
      'Extremely intuitive, easy to use and very good service!',
    ),
  },
];

const evidenceBase = [
  t(
    '<strong>Dado interno de comportamento</strong> — cliques, tempo por tela e erros recorrentes, levantados com Desenvolvimento antes de qualquer proposta.',
    '<strong>Internal behavioral data</strong> — clicks, time per screen and recurring errors, gathered with Development before any proposal.',
  ),
  t(
    '<strong>Regras de negócio</strong> — cada campo cortado ou mantido foi decidido pelo motivo real de existir, direto com o P.O.',
    '<strong>Business rules</strong> — every field cut or kept was decided by its real reason to exist, directly with the PO.',
  ),
  t(
    '<strong>Validação cruzada na matriz CSD</strong> — Produto, Desenvolvimento, Marketing e Suporte revisaram as soluções, reduzindo o risco de decisão unilateral.',
    '<strong>Cross-validation in the CSD matrix</strong> — Product, Development, Marketing and Support reviewed the solutions, reducing the risk of unilateral decisions.',
  ),
];

const learnings = [
  {
    title: t('Entrar num produto sem UX', 'Joining a product with no UX'),
    items: [
      t(
        'Antes de redesenhar qualquer tela, precisei reconstruir a visão do produto inteiro com quatro áreas que nunca tinham sentado juntas.',
        'Before redesigning any screen, I had to rebuild the vision of the whole product with four teams that had never sat down together.',
      ),
      t(
        'O time entendeu, na prática, como UX se conecta a negócio e a dado, não só a “telas bonitas”.',
        'The team saw in practice how UX connects to business and data, not just to “pretty screens”.',
      ),
    ],
  },
  {
    title: t('Rotinas de design na squad', 'Design routines in the squad'),
    items: [
      t(
        'Implantei rotinas de design junto ao squad — documentação e discovery passaram a fazer parte do jeito de trabalhar.',
        'I introduced design routines with the squad — documentation and discovery became part of how we worked.',
      ),
      t(
        'Soluções entregues em alta fidelidade e navegáveis, prontas para a próxima etapa de validação.',
        'Solutions delivered in high fidelity and clickable, ready for the next validation stage.',
      ),
    ],
  },
];
---

<CaseLayout
  title="Trade+ · Redesign do cadastro"
  description="Um cadastro de 30+ telas escondia um produto que ninguém via por inteiro. Descoberta, redesign de fluxo e documentação do app Trade+."
  image={cover.src}
  chapters={[
    { id: 'cap-contexto', label: t('Contexto', 'Context') },
    { id: 'cap-descoberta', label: t('Investigação', 'Research') },
    { id: 'cap-decisoes', label: t('Decisões', 'Decisions') },
    { id: 'cap-solucao', label: t('Soluções', 'Solutions') },
    { id: 'cap-impacto', label: t('Entregas', 'Delivery') },
  ]}
  ambient
  showLang
  cta={{ title: t('Tem um fluxo assim no seu produto?', 'Have a flow like this in your product?') }}
>
  <CaseIntro
    badges={[
      { label: 'UX/UI CASE', color: '#0B7C8F' },
      { label: t('FINTECH · VAREJO', 'FINTECH · RETAIL'), color: '#561589' },
      { label: t('APP MOBILE', 'MOBILE APP'), color: '#6E3FC8' },
    ]}
    eyebrow="TRADE+ · PRODUCT DESIGN · UX/UI · FINTECH"
    title={t(
      'Redesenhando a experiência de cadastro e uso <span class="serif">de um aplicativo de crédito para varejistas</span>',
      'Redesigning the sign-up and usage experience <span class="serif">of a credit app for retailers</span>',
    )}
    lead={t(
      'O que começou como uma migração de telas do Adobe XD para o Figma revelou um desafio maior: um cadastro com mais de 30 telas, regras de negócio distribuídas entre diferentes equipes e oportunidades de melhoria na experiência do aplicativo.',
      'What started as a migration of screens from Adobe XD to Figma revealed a bigger challenge: a sign-up with more than 30 screens, business rules spread across different teams and opportunities to improve the app experience.',
    )}
    facts={[
      { label: t('PAPEL', 'ROLE'), value: 'Product Designer · UX Research' },
      {
        label: t('EQUIPE', 'TEAM'),
        value: t(
          'Product Owner, liderança de UX, Desenvolvimento, Marketing e Suporte',
          'Product Owner, UX lead, Development, Marketing and Support',
        ),
      },
      { label: t('ATUAÇÃO', 'SCOPE'), value: t('Descoberta, redesign de fluxo e documentação', 'Discovery, flow redesign and documentation') },
      { label: t('PLATAFORMA', 'PLATFORM'), value: t('Aplicativo mobile · iOS e Android', 'Mobile app · iOS and Android') },
    ]}
    columns="minmax(0, 1.08fr) minmax(0, 0.92fr)"
    glowSize={480}
    visualMinHeight={600}
  >
    <Image
      class="hero-shot"
      src={telaLogin}
      alt="Tela de boas-vindas do app Trade+ com opções de cadastrar-se e acessar a conta"
      widths={[520, 1040]}
      sizes="(max-width: 860px) 100vw, 520px"
      loading="eager"
      fetchpriority="high"
    />
  </CaseIntro>

  <!-- Resumo / índice -->
  <section id="cap-contexto" aria-labelledby="resumo-title" class="sec rv summary">
    <h2 data-en="Case summary" id="resumo-title" class="sr-only">Resumo do case</h2>
    <div class="cols-3">
      {
        summary.map((item) => (
          <a href={item.href} class="card card--link summary-card">
            <span class="mark">{item.mark}</span>
            <div class="title" data-en={item.title.en} set:html={item.title.pt} />
            <p data-en={`${item.text.en} <span class="go">${item.cta.en}</span>`}>
              {item.text.pt} <span class="go">{item.cta.pt}</span>
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Contexto -->
  <section aria-labelledby="ctx-title" class="sec sec-narrow rv context">
    <p data-en="Part 1 · Context and challenge" class="eyebrow">Parte 1 · Contexto e desafio</p>
    <h2 data-en="Getting to know the product" id="ctx-title" class="h2">Conhecendo o produto</h2>
    <p data-en="Trademaster is a fintech that offers credit solutions for retail, connecting manufacturers and distributors to small and medium-sized merchants. <strong>Trade+</strong> is the app retailers use to check their limits, track financial operations and apply for credit." class="lead">
      A Trademaster é uma fintech que oferece soluções de crédito para o varejo, conectando indústrias e distribuidores
      a pequenos e médios comerciantes. O <strong>Trade+</strong> é o aplicativo pelo qual os varejistas podem acessar
      informações sobre seus limites, acompanhar operações financeiras e solicitar crédito.
    </p>
    <p data-en="The project started with the migration of the existing interfaces to Figma. During that work, I found screens that were not documented, navigation inconsistencies and features that existed in the app but were not represented in the design files." class="lead">
      O projeto começou com a migração das interfaces existentes para o Figma. Durante esse trabalho, identifiquei telas
      que não estavam documentadas, inconsistências de navegação e funcionalidades que existiam no aplicativo, mas não
      estavam representadas nos arquivos de design.
    </p>
    <h3 data-en="The challenge" class="h3 sub-h">O desafio</h3>
    <p data-en="The sign-up had more than 30 screens, with a heavy volume of information, validation errors and reports of people giving up. On top of that, the app offered few features that encouraged users to come back." class="lead">
      O cadastro reunia mais de 30 telas e apresentava um volume elevado de informações, erros de validação e relatos de
      desistência. Além disso, o aplicativo oferecia poucas funcionalidades que incentivassem o acesso recorrente do
      usuário.
    </p>
    <p data-en="The challenge became understanding the existing journey, <strong>simplifying the sign-up</strong> and finding opportunities to make the app more useful in retailers’ daily routines." class="lead">
      O desafio passou a ser compreender a jornada existente, <strong>simplificar o cadastro</strong> e identificar
      oportunidades para tornar o aplicativo mais útil na rotina dos varejistas.
    </p>
  </section>

  <!-- O problema real -->
  <div id="cap-descoberta" class="band band--purple problem">
    <section aria-labelledby="prob-title" class="sec sec-narrow rv">
      <p data-en="Part 2 · Research and discovery" class="eyebrow">Parte 2 · Investigação e descoberta</p>
      <h2 data-en="Rebuilding the product vision" id="prob-title" class="h2">Reconstruindo a visão do produto</h2>
      <p data-en="The work started hands-on: navigating the app and comparing what I found there with the screens available in Adobe XD and Figma. That is where the first inconsistencies appeared. There were screens in the app that were not documented anywhere, screens in Figma that did not exist in Adobe XD and parts of the experience that could only be understood by looking directly at the product in use." class="lead">
        O trabalho começou na prática: navegando pelo aplicativo e comparando o que eu encontrava ali com as telas
        disponíveis no Adobe XD e no Figma. Foi nesse processo que apareceram as primeiras inconsistências. Havia telas
        presentes no app que não estavam documentadas em lugar nenhum, telas no Figma que não existiam no Adobe XD e
        partes da experiência que só podiam ser entendidas olhando diretamente para o produto em uso.
      </p>
