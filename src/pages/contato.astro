---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ChannelRow from '@/components/contact/ChannelRow.astro';
import PageHero from '@/components/ui/PageHero.astro';
import SignOff from '@/components/ui/SignOff.astro';
import { t } from '@/data/i18n';
import { site } from '@/data/site';
import { url } from '@/lib/url';
---

<BaseLayout
  title="Contato"
  description="Freela, vaga efetiva ou mentoria: fale com Ábia Bognola por email, LinkedIn ou WhatsApp."
>
  <PageHero
    id="c-title"
    top={{
      left: { strong: t('Conversar', "Let's talk"), sub: t('Brasil · GMT−3', 'Brazil · GMT−3') },
      right: { strong: '/contact', sub: t('resposta em 1 dia útil', 'reply within 1 business day') },
    }}
    open={t(
      'Freela, vaga efetiva ou mentoria: <span class="k">me conta o que você precisa.</span>',
      'Freelance, full-time or mentoring: <span class="k">tell me what you need.</span>',
    )}
    title={t('Contatos', 'Contacts')}
    sub={t(
      'Três formas de falar comigo, <em>conforme o que você precisa</em>.',
      'Three ways to reach me, <em>depending on what you need</em>.',
    )}
    lead={t(
      'Email para briefing e proposta. LinkedIn para recado rápido ou indicação. E <b>os cases</b>, se quiser entender meu processo antes de escrever.',
      "Email for briefs and proposals. LinkedIn for quick notes or referrals. And the cases, if you'd like to see my process before writing.",
    )}
  />

  <section class="channels" aria-label="Canais">
    <div class="wrap">
      <ChannelRow
        n="01"
        href={`mailto:${site.email}`}
        ariaLabel="Enviar email"
        kind={t('Email · briefing e proposta', 'Email · briefs and proposals')}
        value={t('abiabognola14<br/>@gmail.com')}
        note={t(
          'Para briefing, orçamento ou apresentação de projeto — tudo o que precisa de contexto.',
          'For briefs, budgets or project pitches — anything that needs context.',
        )}
        foot={t('resposta · ~1 dia', 'reply · ~1 day')}
        action={t('Escrever', 'Write')}
      />
      <ChannelRow
        n="02"
        href={site.linkedin}
        external
        ariaLabel="LinkedIn (abre em nova aba)"
        kind={t('LinkedIn · uma linha', 'LinkedIn · short line')}
        value={t('/in/<br/>ábia-bognola')}
        note={t(
          'Recado rápido, conexão, indicação. Também é onde eu atualizo experiência e mentorias.',
          'Quick note, intro, referral. Also where I keep experience and mentoring in sync.',
        )}
        foot={t('resposta · flexível', 'reply · flexible')}
        action={t('Abrir', 'Open')}
      />
      <ChannelRow
        n="03"
        href={url('/cases/')}
        ariaLabel="Ver cases antes de escrever"
        kind={t('Cases · antes de escrever', 'Cases · before writing')}
        value={t('Lê os<br/>cases antes.', 'Read the<br/>cases first.')}
        note={t(
          'Cada case mostra o problema, as decisões e o que ficou sem validar — dá para ver se meu jeito de trabalhar serve ao seu time.',
          'Each case shows the problem, the decisions and what was left unvalidated — enough to tell whether my way of working fits your team.',
        )}
        foot={t('leitura · no seu tempo', 'read · at your pace')}
        action={t('Ver cases', 'See work')}
      />
    </div>
  </section>

  <SignOff size="md" />
</BaseLayout>

<style>
  .channels {
    padding: 60px 0;
  }
</style>
