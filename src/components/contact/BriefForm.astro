---
/**
 * Project brief form. Sends the brief through Web3Forms (static-friendly, no
 * server needed). Without PUBLIC_WEB3FORMS_KEY, or if sending fails, it falls
 * back to a pre-filled mailto.
 */
import ChoiceGroup from './ChoiceGroup.astro';
import Chip from '@/components/ui/Chip.astro';
import { t } from '@/data/i18n';
import { site } from '@/data/site';

const tipos = [
  { value: 'Discovery / research', label: t('Discovery / research') },
  { value: 'Redesign de produto', label: t('Redesign de produto', 'Product redesign') },
  { value: 'Novo produto do zero', label: t('Novo produto do zero', 'New product from scratch') },
  { value: 'Design system', label: t('Design system') },
  { value: 'Mentoria / consultoria', label: t('Mentoria / consultoria', 'Mentoring / consulting') },
  { value: 'Full-time', label: t('Full-time') },
];
const orcamentos = [
  { value: 'Até R$ 10k', label: t('Até R$ 10k', 'Up to $2k USD') },
  { value: 'R$ 10k–30k', label: t('R$ 10k–30k', '$2k–6k USD') },
  { value: 'R$ 30k–80k', label: t('R$ 30k–80k', '$6k–15k USD') },
  { value: 'R$ 80k+', label: t('R$ 80k+', '$15k+ USD') },
  { value: 'Ainda a definir', label: t('A definir', 'To be defined') },
];
const prazos = [
  { value: 'Agora', label: t('Agora', 'Now') },
  { value: 'Em até 30 dias', label: t('Em até 30 dias', 'Within 30 days') },
  { value: 'Em 1–3 meses', label: t('Em 1–3 meses', '1–3 months') },
  { value: 'Flexível', label: t('Flexível', 'Flexible') },
];
---

<form class="brief rv" action="https://api.web3forms.com/submit" method="post" data-brief data-email={site.email}>
  <div class="field">
    <label for="br-name" data-en="Name">Nome</label>
    <input
      id="br-name"
      name="nome"
      type="text"
      required
      maxlength="120"
      autocomplete="name"
      placeholder="Como te chamo?"
      data-en-placeholder="How should I call you?"
    />
  </div>
  <div class="field">
    <label for="br-email" data-en="Email">Email</label>
    <input id="br-email" name="email" type="email" required maxlength="200" autocomplete="email" placeholder="seu@email.com" />
  </div>
  <div class="field full">
    <label for="br-company" data-en={'Company / role <span class="hint">optional</span>'}>
      Empresa / cargo <span class="hint">opcional</span>
    </label>
    <input
      id="br-company"
      name="empresa"
      type="text"
      maxlength="200"
      autocomplete="organization"
      placeholder="Empresa, produto, cargo"
      data-en-placeholder="Company, product, role"
    />
  </div>

  <fieldset class="field full">
    <legend data-en="Kind of project">Tipo de projeto</legend>
    <ChoiceGroup name="tipo" type="checkbox" options={tipos} />
  </fieldset>
  <fieldset class="field">
    <legend data-en="Budget range">Orçamento estimado</legend>
    <ChoiceGroup name="orcamento" type="radio" options={orcamentos} />
  </fieldset>
  <fieldset class="field">
    <legend data-en="When it should start">Quando começar</legend>
    <ChoiceGroup name="prazo" type="radio" options={prazos} />
  </fieldset>

  <div class="field full">
    <label for="br-context" data-en="Project in one paragraph">O projeto em um parágrafo</label>
    <textarea
      id="br-context"
      name="contexto"
      required
      maxlength="5000"
      placeholder="Qual produto, qual usuário, o que está travando hoje?"
      data-en-placeholder="Which product, which user, what's stuck today?"></textarea>
  </div>
  <div class="field full">
    <label for="br-success">
      <span data-en="How will you know it worked?">Como você vai saber que deu certo?</span>
      <span class="hint" data-en="optional">opcional</span>
    </label>
    <textarea
      id="br-success"
      name="sucesso"
      maxlength="2000"
      placeholder="Uma métrica, um comportamento, uma sensação — vale qualquer um."
      data-en-placeholder="A metric, a behavior, a feeling — any of them works."></textarea>
  </div>

  <!-- Honeypot: hidden from people, tempting for bots. -->
  <div class="hp" aria-hidden="true">
    <label for="br-website">Website</label>
    <input id="br-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="submit">
    <Chip type="submit" en="Send the brief" data-submit>Enviar o briefing</Chip>
    <span class="note" data-en={`Reply within 1 business day. Or write directly to ${site.email}`}>
      Resposta em até 1 dia útil. Ou escreve direto pra {site.email}
    </span>
  </div>

  <div class="status" role="status" aria-live="polite">
    <p
      class="msg msg--ok"
      hidden
      data-en="<b>Got it.</b> Your brief is in — I'll reply within one business day."
    >
      <b>Anotado.</b> Seu briefing chegou — respondo em até um dia útil.
    </p>
    <p class="msg msg--error" hidden>
      <span data-en="<b>It didn't go through.</b> Something failed on my side.">
        <b>Não foi dessa vez.</b> Algo falhou do meu lado.
      </span>
      <a href={`mailto:${site.email}`} data-mailto data-en="Send it from your email app →">Enviar pelo seu app de email →</a>
    </p>
  </div>
</form>

<script>
  import { PUBLIC_WEB3FORMS_KEY } from 'astro:env/client';
  import { briefSubject, briefToText, parseBrief } from '@/lib/brief';

  document.querySelectorAll<HTMLFormElement>('[data-brief]').forEach((form) => {
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const ok = form.querySelector<HTMLElement>('.msg--ok')!;
    const error = form.querySelector<HTMLElement>('.msg--error')!;
    const mailto = form.querySelector<HTMLAnchorElement>('[data-mailto]')!;
    const email = form.dataset.email!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const fd = new FormData(form);
      // Honeypot: real visitors never fill this hidden field.
      if (String(fd.get('website') ?? '').trim()) return;

      const { brief } = parseBrief({ ...Object.fromEntries(fd), tipo: fd.getAll('tipo') });
      const subject = briefSubject(brief);
      const message = briefToText(brief);
      mailto.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(message)}`;

      // No key configured: go straight to the visitor's email app.
      if (!PUBLIC_WEB3FORMS_KEY) {
        window.location.href = mailto.href;
        return;
      }

      submit.disabled = true;
      form.setAttribute('aria-busy', 'true');
      error.hidden = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: PUBLIC_WEB3FORMS_KEY,
            subject,
            from_name: brief.nome,
            email: brief.email,
            replyto: brief.email,
            message,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) throw new Error(String(res.status));
        form.classList.add('sent');
        ok.hidden = false;
        ok.focus?.();
      } catch {
        error.hidden = false;
      } finally {
        submit.disabled = false;
        form.removeAttribute('aria-busy');
      }
    });
  });
</script>

<style>
  .brief {
    grid-column: 5 / 13;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 24px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    border: 0;
  }

  .full {
    grid-column: 1 / -1;
  }

  label,
  legend {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    width: 100%;
    font-family: var(--ff-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rose-light);
  }

  legend {
    float: left;
    margin-bottom: 8px;
  }

  .brief :global(.hint) {
    font-size: 10.5px;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--warm-40);
  }

  input,
  textarea {
    width: 100%;
    padding: 12px 0 14px;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.24);
    background: transparent;
    color: var(--text-strong);
    font-family: var(--ff-sans);
    font-size: 17px;
    line-height: 1.5;
    transition:
      border-color 0.3s,
      box-shadow 0.3s;
  }

  input::placeholder,
  textarea::placeholder {
    font-style: italic;
    color: rgba(243, 242, 255, 0.42);
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--rose);
    box-shadow: 0 8px 20px -14px rgba(158, 108, 239, 0.7);
  }

  textarea {
    min-height: 120px;
    resize: vertical;
    line-height: 1.65;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
  }

  .submit :global(button[disabled]) {
    opacity: 0.6;
    cursor: progress;
  }

  .note {
    max-width: 260px;
    font-family: var(--ff-mono);
    font-size: 10.5px;
    line-height: 1.6;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--warm-40);
  }

  .status {
    grid-column: 1 / -1;
  }

  .msg {
    padding: 24px 26px;
    border: 1px solid var(--rose);
    background: rgba(158, 108, 239, 0.08);
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-strong);
  }

  .msg--error {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    border-color: var(--warning);
    background: rgba(242, 182, 109, 0.08);
  }

  .msg--error[hidden],
  .msg[hidden] {
    display: none;
  }

  .msg a {
    font-weight: 600;
    color: var(--rose-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* After a successful send only the confirmation stays visible. */
  .brief:global(.sent) > :not(.status) {
    display: none;
  }

  @media (max-width: 820px) {
    .brief {
      grid-template-columns: 1fr;
    }
  }
</style>
