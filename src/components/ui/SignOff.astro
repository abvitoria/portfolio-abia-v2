---
/**
 * Closing contact block: big "Manda um oi." headline, WhatsApp link and a
 * side column with LinkedIn / about / availability. Used on Home and Contato.
 */
import BrandIcon from './BrandIcon.astro';
import Kicker from './Kicker.astro';
import { site } from '@/data/site';
import { t } from '@/data/i18n';
import { url } from '@/lib/url';

interface Props {
  /** Show the "· epílogo / contato" kicker above the headline. */
  kicker?: boolean;
  size?: 'lg' | 'md';
}

const { kicker = false, size = 'lg' } = Astro.props;
const side = {
  pt: `<a href="${url('/sobre/')}">Sobre mim ↗</a><br/>GMT−3 · Brasil<br/>Aberta pra freela e efetivo`,
  en: `<a href="${url('/sobre/')}">About me ↗</a><br/>GMT−3 · Brazil<br/>Open to freelance and full-time`,
};
---

<section class:list={['signoff', `signoff--${size}`]} aria-label="Contato">
  <div class="wrap grid12">
    {kicker && <Kicker class="kick" label={t('· epílogo', '· epilogue')} title={t('contato', 'contact')} />}
    <h2
      class="big rv"
      data-en={'Say <span class="k">hi.</span><i>I reply within one business day.</i>'}
    >
      Manda um <span class="k">oi.</span><i>Respondo em até um dia útil.</i>
    </h2>
    <a href={site.whatsapp} target="_blank" rel="noopener" class="talk rv">
      <BrandIcon name="whatsapp" size={28} />
      <span data-en="Talk to me ↗">Fale comigo ↗</span>
    </a>
    <div class="side rv">
      <a href={site.linkedin} target="_blank" rel="noopener" class="linkedin">
        <BrandIcon name="linkedin" size={16} />
        LinkedIn ↗
      </a>
      <div data-en={side.en} set:html={side.pt} />
    </div>
  </div>
</section>

<style>
  .signoff {
    position: relative;
    overflow: hidden;
    padding: 18vh 0 12vh;
  }

  .signoff--lg {
    padding: clamp(72px, 12vh, 120px) 0 16vh;
  }

  @media (max-width: 820px) {
    .signoff--lg {
      padding: 56px 0 12vh;
    }
  }

  .signoff :global(.kick) {
    grid-column: 1 / 4;
  }

  .big {
    grid-column: 1 / 13;
    margin: 0;
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: clamp(56px, 10vw, 180px);
    line-height: 0.86;
    letter-spacing: -0.03em;
    color: var(--warm);
  }

  .signoff--lg .big {
    margin-top: 36px;
    font-size: clamp(72px, 12vw, 200px);
  }

  .big :global(.k) {
    text-shadow: 0 0 60px rgba(158, 108, 239, 0.45);
  }

  .big :global(i) {
    display: block;
    max-width: 620px;
    margin-top: 20px;
    font-family: var(--ff-sans);
    font-style: italic;
    font-weight: 300;
    font-size: 0.28em;
    line-height: 1.35;
    letter-spacing: -0.005em;
    color: var(--warm-70);
  }

  .signoff--lg .big :global(i) {
    font-size: 0.32em;
  }

  .talk {
    grid-column: 1 / 9;
    justify-self: start;
    align-self: start;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 56px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--warm-40);
    font-family: var(--ff-mono);
    font-size: clamp(18px, 2.2vw, 30px);
    color: var(--warm);
    transition:
      color 0.3s,
      border-color 0.3s;
  }

  .talk:hover {
    color: var(--rose);
    border-color: var(--rose);
  }

  .side {
    grid-column: 9 / 13;
    margin-top: 56px;
    font-family: var(--ff-mono);
    font-size: 11px;
    line-height: 2.2;
    letter-spacing: 0.02em;
    color: var(--warm-70);
  }

  .side .linkedin {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    padding: 10px 18px;
    border: 1px solid var(--warm-40);
    border-radius: var(--radius-pill);
    font-size: 13px;
    line-height: 1;
    color: var(--warm);
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .side .linkedin:hover {
    color: var(--rose);
    border-color: var(--rose);
  }

  .side :global(div a) {
    border-bottom: 1px solid var(--warm-14);
    color: var(--warm);
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  .side :global(div a:hover) {
    color: var(--rose);
    border-color: var(--rose);
  }

  @media (max-width: 820px) {
    .talk {
      font-size: 22px;
    }
  }
</style>
