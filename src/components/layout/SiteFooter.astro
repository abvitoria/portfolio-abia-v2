---
/**
 * Site footer. `dark` (default): copyright strip. `paper`: wordmark +
 * tagline for the light About page.
 */
import { site } from '@/data/site';

interface Props {
  variant?: 'dark' | 'paper';
}

const { variant = 'dark' } = Astro.props;
---

{
  variant === 'paper' ? (
    <footer class="foot foot--paper">
      <div class="wm">
        {site.name.toUpperCase()}
        <span class="dot">.</span>
      </div>
      <div>© {site.year} · Portfólio de product design.</div>
    </footer>
  ) : (
    <footer class="foot">
      <div data-en={`© ${site.year} · ${site.name}`}>
        © {site.year} · {site.name}
      </div>
    </footer>
  )
}

<style>
  .foot {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    padding: 24px 40px;
    border-top: 1px solid var(--warm-14);
    font-family: var(--ff-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--warm-40);
  }

  .foot--paper {
    max-width: 1440px;
    margin: 0 auto;
    padding: 26px 40px;
    border: 0;
    font-family: var(--ff-sans);
    font-size: 12px;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-2);
  }

  .wm {
    font-family: var(--ff-display);
    font-size: 18px;
    color: var(--ink);
  }

  .dot {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .foot {
      flex-direction: column;
      gap: 6px;
      padding: 18px 20px;
    }
  }
</style>
