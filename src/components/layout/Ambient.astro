---
/**
 * Ambient background: drifting aurora blobs + a cursor spotlight.
 * Purely decorative; disabled with reduced motion.
 */
---

<div class="aurora" aria-hidden="true"><span class="a3"></span></div>
<div class="spot" aria-hidden="true"></div>

<script>
  import '@/scripts/spotlight';
</script>

<style>
  .aurora {
    position: fixed;
    inset: -10%;
    z-index: var(--z-ambient);
    pointer-events: none;
    filter: blur(120px) saturate(120%);
    opacity: 0.55;
  }

  .aurora::before,
  .aurora::after,
  .a3 {
    content: '';
    position: absolute;
    display: block;
    border-radius: 50%;
    mix-blend-mode: screen;
  }

  .aurora::before {
    width: 60vw;
    height: 60vw;
    left: -10vw;
    top: -10vw;
    background: radial-gradient(circle, var(--rose-deep), transparent 65%);
    animation: drift1 22s ease-in-out infinite alternate;
  }

  .aurora::after {
    width: 55vw;
    height: 55vw;
    right: -8vw;
    top: 20vh;
    background: radial-gradient(circle, var(--plum), transparent 65%);
    animation: drift2 28s ease-in-out infinite alternate;
  }

  .a3 {
    width: 40vw;
    height: 40vw;
    left: 35vw;
    bottom: -15vh;
    opacity: 0.55;
    background: radial-gradient(circle, var(--gold), transparent 65%);
    animation: drift3 30s ease-in-out infinite alternate;
  }

  @keyframes drift1 {
    to {
      transform: translate(15vw, 10vh) scale(1.15);
    }
  }

  @keyframes drift2 {
    to {
      transform: translate(-12vw, -8vh) scale(1.1);
    }
  }

  @keyframes drift3 {
    to {
      transform: translate(-20vw, -6vh) scale(1.2);
    }
  }

  .spot {
    position: fixed;
    inset: 0;
    z-index: var(--z-spot);
    pointer-events: none;
    background: radial-gradient(
      600px circle at var(--mx, 50%) var(--my, 50%),
      rgba(158, 108, 239, 0.14),
      transparent 60%
    );
  }

  @media (hover: none) {
    .spot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora,
    .spot {
      display: none;
    }
  }
</style>
