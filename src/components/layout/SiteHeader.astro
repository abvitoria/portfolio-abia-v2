---
/**
 * Fixed site header: brand mark, primary navigation and PT/EN toggle.
 * The active item is resolved at build time from the current URL.
 */
import { Image } from 'astro:assets';
import logo from '@/assets/brand/uxfinity-logo-branca.png';
import { nav, site } from '@/data/site';
import { url } from '@/lib/url';

interface Props {
  /** Show the PT/EN toggle (pages without English copy hide it). */
  showLang?: boolean;
}

const { showLang = true } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => (href === url('/') ? path === href : path.startsWith(href));
---

<header class="hdr">
  <a href={url('/')} class="mark" aria-label={`${site.brand} · ${site.name} — início`}>
    <Image src={logo} alt={site.brand} height={30} loading="eager" />
  </a>
  <div class="nav-wrap">
    <nav class="nav" aria-label="Navegação principal">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            data-en={showLang ? item.en : undefined}
          >
            {item.pt}
          </a>
        ))
      }
    </nav>
    {
      showLang && (
        <div class="lang" role="group" aria-label="Idioma / Language">
          <button type="button" data-lang="pt" aria-pressed="true">PT</button>
          <button type="button" data-lang="en" aria-pressed="false">EN</button>
        </div>
      )
    }
  </div>
</header>

<script>
  import '@/scripts/i18n';
</script>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 40px;
    font-family: var(--ff-mono);
  }

  .hdr::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(3, 4, 58, 0.82),
      rgba(3, 4, 58, 0.55) 60%,
      rgba(3, 4, 58, 0.22) 92%,
      transparent
    );
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  .mark {
    display: flex;
    align-items: center;
  }

  .mark img {
    height: 30px;
    width: auto;
  }

  .nav-wrap {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .nav {
    display: flex;
    gap: 24px;
  }

  .nav a {
    position: relative;
    padding: 8px 14px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--warm-70);
    transition:
      color 0.2s ease,
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .nav a:hover {
    color: var(--warm);
    border-color: rgba(243, 242, 255, 0.18);
  }

  .nav a[aria-current='page'] {
    color: var(--void);
    background: var(--rose);
    border-color: var(--rose);
    box-shadow: 0 6px 18px rgba(158, 108, 239, 0.35);
  }

  .lang {
    display: inline-flex;
    overflow: hidden;
    border: 1px solid var(--warm-14);
    border-radius: var(--radius-pill);
    background: rgba(3, 4, 58, 0.35);
    font-size: 10.5px;
    letter-spacing: 0.02em;
  }

  .lang button {
    appearance: none;
    padding: 6px 11px;
    border: 0;
    background: transparent;
    color: var(--warm-70);
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
    transition:
      background 0.3s,
      color 0.3s;
  }

  .lang button:hover {
    color: var(--warm);
  }

  .lang button[aria-pressed='true'] {
    background: var(--rose);
    color: var(--void);
  }

  @media (max-width: 820px) {
    .hdr {
      padding: 14px 20px;
    }

    .nav-wrap,
    .nav {
      gap: 12px;
    }

    .nav a {
      font-size: 10.5px;
      letter-spacing: 0.06em;
    }
  }

  @media (max-width: 560px) {
    .hdr {
      padding: 12px 16px;
    }

    .mark img {
      height: 24px;
    }

    .nav-wrap {
      gap: 8px;
    }

    .nav {
      gap: 0;
    }

    .nav a {
      padding: 7px 6px;
      font-size: 9.5px;
      letter-spacing: 0.04em;
    }

    .lang button {
      padding: 5px 8px;
    }
  }

  @media print {
    .hdr {
      display: none;
    }
  }
</style>
