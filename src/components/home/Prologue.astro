---
/** Full-height statement: "how I see design". */
import Kicker from '@/components/ui/Kicker.astro';
import { t } from '@/data/i18n';
---

<section class="prologue">
  <h1 class="sr-only">Ábia Bognola · Product Designer</h1>
  <div class="wrap grid12">
    <Kicker class="mark rv" label={t('· prólogo', '· prologue')} title={t('como vejo o design', 'how I see design')} />
    <p
      class="line kin rv"
      data-en="Between what is asked for and what is <em>actually needed</em>, there is room to question, investigate and create."
    >
      Entre o que é pedido e o que <em>realmente é necessário</em>, existe espaço para questionar, investigar e criar.
    </p>
  </div>
</section>

<style>
  /* Home sections share one rhythm: clamp(72px, 12vh, 120px) per side,
     56px on phones (Prologue, cases, Interlude, SignOff lg). */
  .prologue {
    position: relative;
    padding: clamp(72px, 12vh, 120px) 0;
    /* First block of the Home: clears the fixed header. */
    padding-top: calc(var(--header-h) + clamp(72px, 12vh, 120px));
  }

  .prologue :global(.mark) {
    grid-column: 1 / 3;
  }

  .line {
    grid-column: 3 / 13;
    max-width: 1100px;
    font-weight: 300;
    font-size: clamp(36px, 5vw, 72px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .line :global(em) {
    font-style: italic;
    font-weight: 400;
    color: var(--rose);
  }

  @media (max-width: 820px) {
    .prologue {
      padding: calc(var(--header-h) + 56px) 0 56px;
    }

    .line {
      margin-top: 16px;
      font-size: 32px;
    }
  }
</style>
