---
/** "How I work" — three acts. */
import Kicker from '@/components/ui/Kicker.astro';
import { t } from '@/data/i18n';

const acts = [
  {
    n: '01',
    title: t('Entender <span class="k">o contexto</span>', 'Understand <span class="k">the context</span>'),
    body: t(
      'Investigo necessidades, objetivos de negócio e restrições para compreender o problema antes de definir uma solução.',
      'I investigate needs, business goals, and constraints to understand the problem before defining a solution.',
    ),
  },
  {
    n: '02',
    title: t('Explorar <span class="k">possibilidades</span>', 'Explore <span class="k">possibilities</span>'),
    body: t(
      'Estruturo jornadas, comparo alternativas e utilizo protótipos para tornar decisões de design mais claras.',
      'I structure user journeys, compare alternatives, and use prototypes to make design decisions clearer.',
    ),
  },
  {
    n: '03',
    title: t('Evoluir <span class="k">em conjunto</span>', 'Evolve <span class="k">together</span>'),
    body: t(
      'Trabalho com outras disciplinas para refinar soluções, considerar a viabilidade técnica e manter consistência na experiência.',
      'I work with other disciplines to refine solutions, consider technical feasibility, and maintain consistency across the experience.',
    ),
  },
];
---

<section class="interlude">
  <div class="wrap grid12">
    <Kicker class="kick" label={t('· interlúdio', '· interlude')} title={t('como eu trabalho', 'how I work')} />
    <p
      class="head rv"
      data-en="My process does not always start in the same place. <em>It adapts to the problem I need to solve.</em>"
    >
      Meu processo não começa sempre no mesmo lugar. <em>Ele se adapta ao problema que preciso resolver.</em>
    </p>
    <div class="acts">
      {
        acts.map((act) => (
          <div class="act rv">
            <div class="n">{act.n}</div>
            <h3 data-en={act.title.en} set:html={act.title.pt} />
            <p data-en={act.body.en} set:html={act.body.pt} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .interlude {
    position: relative;
    padding: clamp(72px, 12vh, 120px) 0;
  }

  @media (max-width: 820px) {
    .interlude {
      padding: 56px 0;
    }
  }

  .interlude :global(.kick) {
    grid-column: 1 / 3;
  }

  .head {
    grid-column: 3 / 13;
    max-width: 1000px;
    font-weight: 300;
    font-size: clamp(32px, 4.2vw, 60px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .head :global(em) {
    font-style: italic;
    font-weight: 400;
    color: var(--rose);
  }

  .acts {
    grid-column: 3 / 13;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 64px;
  }

  .act {
    position: relative;
    padding: 32px 26px 28px;
    border: 1px solid var(--warm-14);
    border-radius: var(--radius-xs);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.025), transparent);
    transition:
      translate 0.6s var(--ease-out),
      border-color 0.3s,
      background 0.3s;
  }

  .act:hover {
    translate: 0 -6px;
    border-color: var(--rose);
    background: linear-gradient(180deg, rgba(158, 108, 239, 0.08), transparent);
  }

  .n {
    margin-bottom: 20px;
    font-family: var(--ff-mono);
    font-size: 10.5px;
    letter-spacing: 0.02em;
    color: var(--warm-40);
  }

  h3 {
    margin: 0 0 14px;
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: 44px;
    line-height: 0.96;
    letter-spacing: -0.01em;
    color: var(--warm);
  }

  .act p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--warm-70);
  }

  @media (max-width: 820px) {
    .acts {
      grid-template-columns: 1fr;
      margin-top: 32px;
    }
  }
</style>
