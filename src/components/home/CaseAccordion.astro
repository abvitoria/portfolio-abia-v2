---
/**
 * Editorial list of cases on the Home: each row expands (native <details>)
 * into cover + problem / solution / result. Data: src/data/cases.ts
 */
import { Image } from 'astro:assets';
import Chip from '@/components/ui/Chip.astro';
import { caseHref, cases } from '@/data/cases';

const fields = [
  { key: 'problem', pt: 'Problema', en: 'Problem' },
  { key: 'solution', pt: 'Solução', en: 'Solution' },
  { key: 'result', pt: 'Resultado', en: 'Outcome' },
] as const;
---

<div class="list">
  {
    cases.map((c, i) => (
      <details class="item" id={`ch-${i + 1}`} open={i === 0}>
        <summary class="sum">
          <span class="idx">{String(i + 1).padStart(2, '0')}</span>
          <span class="name" data-en={c.name.en} set:html={c.name.pt} />
          <span class="headline" data-en={c.home.headline.en} set:html={c.home.headline.pt} />
          <span class="meta" data-en={c.home.meta.en} set:html={c.home.meta.pt} />
          <span class="sign" aria-hidden="true">+</span>
        </summary>
        <div class="body">
          <span />
          <a href={caseHref(c.slug)} class="cover" tabindex="-1" aria-hidden="true">
            <Image src={c.cover} alt={c.coverAlt} width={380} densities={[1, 2]} />
          </a>
          <div class="facts">
            {fields.map((f) => (
              <div class="fact">
                <span class:list={['fact-label', { 'fact-label--result': f.key === 'result' }]} data-en={f.en}>
                  {f.pt}
                </span>
                <p
                  class:list={['fact-text', { 'fact-text--result': f.key === 'result' }]}
                  data-en={c.home[f.key].en}
                  set:html={c.home[f.key].pt}
                />
              </div>
            ))}
            <div class="cta">
              <Chip href={caseHref(c.slug)} en="Read the case">Ler o case</Chip>
              <span class="role">{c.home.role}</span>
            </div>
          </div>
        </div>
      </details>
    ))
  }
</div>

<style>
  .list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--warm-14);
  }

  .item {
    border-bottom: 1px solid var(--warm-14);
  }

  .sum {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) minmax(0, 1.1fr) 180px 40px;
    gap: 28px;
    align-items: center;
    padding: 32px 0;
    list-style: none;
    cursor: pointer;
  }

  .sum::-webkit-details-marker {
    display: none;
  }

  .sum:focus-visible {
    outline: 2px solid var(--rose);
    outline-offset: 4px;
  }

  .idx {
    font-family: var(--ff-mono);
    font-size: 13px;
    color: var(--rose);
  }

  .name {
    font-family: var(--ff-display);
    font-size: clamp(48px, 6vw, 84px);
    line-height: 0.85;
    color: var(--warm);
    transition: color 0.3s;
  }

  .sum:hover .name {
    color: var(--rose);
  }

  .headline {
    font-size: 18px;
    line-height: 1.35;
    color: var(--warm-70);
  }

  .meta {
    font-family: var(--ff-mono);
    font-size: 11px;
    line-height: 1.6;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--warm-40);
  }

  .sign {
    font-size: 28px;
    text-align: right;
    color: var(--rose);
    transition: transform 0.3s;
  }

  .item[open] .sign {
    transform: rotate(45deg);
  }

  .body {
    display: grid;
    grid-template-columns: 72px minmax(0, 380px) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
    padding: 0 0 48px;
  }

  .cover {
    display: block;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: #070838;
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .cover:hover img {
    transform: scale(1.03);
  }

  .facts {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .fact-label {
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rose);
  }

  .fact-label--result {
    color: var(--gold);
  }

  .fact-text {
    font-size: 16px;
    line-height: 1.6;
    color: var(--warm-70);
  }

  .fact-text--result {
    color: var(--warm);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  .role {
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--warm-40);
  }

  @media (max-width: 820px) {
    .sum {
      grid-template-columns: 40px minmax(0, 1fr) 28px;
      gap: 12px 16px;
      padding: 24px 0;
    }

    .headline,
    .meta {
      grid-column: 2 / 3;
    }

    .sign {
      grid-row: 1;
      grid-column: 3;
    }

    .body {
      grid-template-columns: 1fr;
    }

    .body > span:first-child {
      display: none;
    }
  }
</style>
