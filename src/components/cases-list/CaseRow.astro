---
/**
 * One row of the /cases list: index, meta, big title, summary, tags, CTA and
 * a stat frame on the right. The whole row is a link to the case.
 */
import BgNum from '@/components/ui/BgNum.astro';
import Chip from '@/components/ui/Chip.astro';
import DotLine from '@/components/ui/DotLine.astro';
import Tag from '@/components/ui/Tag.astro';
import { caseHref, designerActor, type CaseEntry } from '@/data/cases';
import { t } from '@/data/i18n';

interface Props {
  entry: CaseEntry;
  index: number;
}

const { entry, index } = Astro.props;
const { row } = entry;
const n = String(index + 1).padStart(2, '0');
const actors = [...row.actors, designerActor];
---

<a href={caseHref(entry.slug)} class="row" id={`row-${index + 1}`} aria-label={`Ver case ${entry.short}`}>
  <BgNum n={n} />
  <div class="wrap grid12">
    <div class="idx">{n}</div>
    <div class="meta" data-en={row.meta.en} set:html={row.meta.pt} />
    <h2 class="title rv" data-en={row.title.en} set:html={row.title.pt} />
    {
      row.context && row.myRole ? (
        <div class="facts rv">
          {[
            { label: t('Contexto', 'Context'), text: row.context },
            { label: t('Minha atuação', 'My role'), text: row.myRole },
          ].map((f) => (
            <div class="fact">
              <span class="fact-label" data-en={f.label.en} set:html={f.label.pt} />
              <p data-en={f.text.en} set:html={f.text.pt} />
            </div>
          ))}
        </div>
      ) : (
        <>
          <p class="body rv" data-en={row.body.en} set:html={row.body.pt} />
          <p class="beat rv" data-en={row.beat.en} set:html={row.beat.pt} />
        </>
      )
    }
    <div class="tags">{row.tags.map((tag) => <Tag label={tag} />)}</div>
    <div class="link"><Chip as="span" en="Read the case">Ler o case</Chip></div>
    <div class="visual" aria-hidden="true">
      <div class="frame">
        {
          row.panel ? (
            <div class="stage stage--panel">
              <div class="panel-title" data-en={row.panel.title.en} set:html={row.panel.title.pt} />
              <dl class="stats">
                {row.panel.stats.map((stat) => (
                  <div>
                    <dt class="stat-num" set:html={stat.value} />
                    <dd class="stat-label" data-en={stat.label.en} set:html={stat.label.pt} />
                  </div>
                ))}
              </dl>
              <p class="panel-caption" data-en={row.panel.caption.en} set:html={row.panel.caption.pt} />
            </div>
          ) : (
            <div class="stage">
              {row.stat.title && (
                <div class="panel-title stat-title" data-en={row.stat.title.en} set:html={row.stat.title.pt} />
              )}
              <div class="big-num" set:html={row.stat.value} />
              <div class="cap" data-en={row.stat.caption.en} set:html={row.stat.caption.pt} />
              <ul>
                {actors.map((actor, i) => (
                  <li class:list={{ self: i === actors.length - 1 }} data-en={actor.en} set:html={actor.pt} />
                ))}
              </ul>
            </div>
          )
        }
        <DotLine class="foot" label={row.status} trail={n} />
      </div>
    </div>
  </div>
</a>

<style>
  .row {
    position: relative;
    display: block;
    overflow-x: clip;
    padding: 80px 0;
    border-top: 1px solid var(--warm-14);
    color: inherit;
  }

  .row:last-of-type {
    border-bottom: 1px solid var(--warm-14);
  }

  .row .grid12 {
    position: relative;
    z-index: 1;
  }

  .idx {
    grid-column: 1 / 2;
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--rose);
  }

  .meta {
    grid-column: 2 / 9;
    margin-bottom: 16px;
    font-family: var(--ff-mono);
    font-size: 10.5px;
    letter-spacing: 0.02em;
    color: var(--warm-40);
  }

  .meta :global(span) {
    margin: 0 6px;
    color: var(--warm-14);
  }

  .title {
    grid-column: 2 / 9;
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: clamp(52px, 7vw, 110px);
    line-height: 0.86;
    letter-spacing: -0.02em;
    color: var(--warm);
    transition: color 0.3s;
  }

  .row:hover .title {
    color: var(--rose);
  }

  .body {
    grid-column: 2 / 8;
    max-width: 560px;
    margin-top: 24px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--warm);
  }

  .body :global(b) {
    font-weight: 500;
    color: var(--rose);
  }

  .beat {
    grid-column: 2 / 8;
    max-width: 560px;
    margin-top: 16px;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--warm-70);
  }

  .facts {
    grid-column: 2 / 8;
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 560px;
    margin-top: 28px;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .fact-label {
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--rose);
  }

  .fact p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--warm-70);
  }

  .tags {
    grid-column: 2 / 8;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 26px;
  }

  .link {
    grid-column: 2 / 8;
    margin-top: 34px;
  }

  .visual {
    grid-column: 9 / 13;
    grid-row: 2 / 8;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 420px;
    padding-top: 26px;
  }

  .frame {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    height: 420px;
    padding: 36px 34px;
    overflow: hidden;
    border-radius: 6px;
    background: linear-gradient(160deg, rgba(158, 108, 239, 0.08), rgba(26, 20, 102, 0.35));
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.45),
      0 0 0 1px var(--warm-14);
    transition:
      transform 0.6s var(--ease-out),
      box-shadow 0.6s;
  }

  .row:hover .frame {
    transform: translateY(-6px);
    box-shadow:
      0 40px 100px rgba(158, 108, 239, 0.16),
      0 0 0 1px rgba(158, 108, 239, 0.4);
  }

  .frame :global(.foot) {
    position: absolute;
    left: 34px;
    right: 34px;
    bottom: 24px;
  }

  .stage {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
  }

  .big-num {
    font-family: var(--ff-display);
    font-size: clamp(140px, 15vw, 220px);
    line-height: 0.82;
    letter-spacing: -0.04em;
    color: var(--warm);
    text-shadow: 0 0 60px rgba(158, 108, 239, 0.28);
  }

  .big-num :global(.k) {
    display: inline-block;
    transform: translateY(-0.08em);
  }

  .stat-title {
    margin-bottom: 18px;
  }

  .cap {
    margin: -6px 0 28px;
    padding-left: 4px;
    font-family: var(--ff-mono);
    font-size: 10.5px;
    letter-spacing: 0.02em;
    color: var(--warm-40);
  }

  .stage--panel {
    gap: 24px;
    padding-bottom: 32px;
  }

  .panel-title {
    font-family: var(--ff-mono);
    font-size: 10.5px;
    letter-spacing: 0.02em;
    color: var(--rose);
  }

  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    width: 100%;
    margin: 0;
  }

  .stats > div {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .stat-num {
    font-family: var(--ff-display);
    font-size: clamp(88px, 8vw, 128px);
    line-height: 0.82;
    letter-spacing: -0.03em;
    color: var(--warm);
    text-shadow: 0 0 60px rgba(158, 108, 239, 0.28);
  }

  .stat-label {
    margin: 0;
    padding-top: 10px;
    border-top: 1px solid var(--warm-14);
    font-family: var(--ff-mono);
    font-size: 10.5px;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--warm-70);
  }

  .panel-caption {
    font-size: 13px;
    line-height: 1.6;
    color: var(--warm-70);
  }

  ul {
    width: 100%;
    max-width: 280px;
    padding-top: 16px;
    border-top: 1px solid var(--warm-14);
    list-style: none;
    font-family: var(--ff-mono);
    font-size: 11px;
    line-height: 2;
    letter-spacing: 0.02em;
    color: var(--warm-70);
  }

  li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  li.self {
    color: var(--warm);
  }

  @media (max-width: 820px) {
    .visual {
      min-height: auto;
      margin-top: 36px;
    }

    .frame {
      height: 340px;
    }
  }
</style>
