---
/** Big divider between case parts: "Parte 1 · Contexto e problema". */
interface Props {
  part: string;
  title: string;
  id?: string;
}

const { part, title, id } = Astro.props;
---

<div class="part wrap--case" id={id}>
  <span class="tag-mono tag-mono--cyan">{part}</span>
  <span class="title">{title}</span>
</div>

<style>
  .part {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 20px;
    margin: 0 auto;
    padding-top: calc(160px * var(--sp, 1));
  }

  @media (max-width: 820px) {
    .part {
      flex-direction: column;
      gap: 8px;
    }
  }

  .title {
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
</style>
