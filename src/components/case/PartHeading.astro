---
/** Big divider between case parts: "Parte 1 · Contexto e problema". */
import { en, pt, type T } from '@/data/i18n';

interface Props {
  part: T;
  title: T;
  id?: string;
}

const { part, title, id } = Astro.props;
---

<div class="part wrap--case" id={id}>
  <span class="tag-mono tag-mono--cyan" data-en={en(part)} set:html={pt(part)} />
  <span class="title" data-en={en(title)} set:html={pt(title)} />
</div>

<style>
  .part {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 20px;
    margin: 0 auto;
    padding-top: calc(160px * var(--sp, 1));
  }

  /* The block right after a part belongs to it: same gap on every page,
     whatever spacing that block asks for. */
  .part + :global(.wrap--case) {
    padding-top: calc(64px * var(--sp, 1));
  }

  @media (max-width: 820px) {
    .part {
      flex-direction: column;
      gap: 8px;
      padding-top: 104px;
    }

    /* On one column the hairline would cut the part title off from its
       first section, so it goes and the section sits right below. */
    .part + :global(.wrap--case) {
      padding-top: 36px;
    }

    .part + :global(.wrap--case) :global(.rule) {
      padding-top: 0;
      border-top: 0;
    }
  }

  .title {
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
</style>
