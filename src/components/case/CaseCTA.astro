---
/** Closing block of every case: question, WhatsApp link + back / more cases buttons. */
import BrandIcon from '@/components/ui/BrandIcon.astro';
import Button from '@/components/ui/Button.astro';
import { en, pt, t, type T } from '@/data/i18n';
import { site } from '@/data/site';
import { url } from '@/lib/url';

interface Props {
  title?: T;
  text?: T;
}

const {
  title = t('Tem um desafio parecido no seu produto?', 'Facing a similar challenge in your product?'),
  text = t(
    'Me conta o contexto — respondo em até um dia útil.',
    "Tell me the context — I'll reply within one business day.",
  ),
} = Astro.props;
---

<section class="cta wrap--case" aria-label="Contato">
  <h2 data-en={en(title)} set:html={pt(title)} />
  <p data-en={en(text)} set:html={pt(text)} />
  <a href={site.whatsapp} target="_blank" rel="noopener" class="wa">
    <BrandIcon name="whatsapp" size={20} />
    <span data-en="Message me on WhatsApp ↗">Fale comigo no WhatsApp ↗</span>
  </a>
  <div class="actions">
    <Button href={url('/cases/')} variant="ghost" data-back en="← Back to previous page">← Voltar à tela anterior</Button>
    <Button href={url('/cases/')} en="See more cases →">Ver mais cases →</Button>
  </div>
</section>

<script>
  // "Back" returns to the previous page when the visitor came from this site.
  document.querySelectorAll<HTMLAnchorElement>('[data-back]').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (document.referrer.startsWith(location.origin) && history.length > 1) {
        e.preventDefault();
        history.back();
      }
    });
  });
</script>

<style>
  .cta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: calc(120px * var(--sp, 1)) auto 0;
    padding-bottom: calc(96px * var(--sp, 1));
  }

  h2 {
    margin: 0;
    font-size: 34px;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  p {
    margin: 0 0 16px;
    font-size: 17px;
    line-height: 1.75;
    color: var(--warm-70);
  }

  .wa {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: -4px 0 24px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--warm-40);
    font-size: 17px;
    font-weight: 600;
    color: var(--warm);
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .wa:hover {
    color: var(--rose-light);
    border-color: var(--rose-light);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
</style>
