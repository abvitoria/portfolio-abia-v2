---
/**
 * A solution step: small cyan label + h3 on the left, text on the right,
 * and a full-width figure (or anything) below via the "media" slot.
 */
interface Props {
  id: string;
  label: string;
  /** Heading (inline HTML allowed). */
  title: string;
}

const { id, label, title } = Astro.props;
---

<section class="step wrap--case" aria-labelledby={id}>
  <div class="cols">
    <div class="head">
      <span class="label label--cyan">{label}</span>
      <h3 id={id} set:html={title} />
    </div>
    <div class="body">
      <slot />
    </div>
  </div>
  <slot name="media" />
</section>

<style>
  .step {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin: 0 auto;
    padding-top: calc(96px * var(--sp, 1));
  }

  .cols {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 24px 72px;
  }

  .head {
    flex: 1 1 280px;
    max-width: 360px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h3 {
    margin: 0;
    font-size: 26px;
    font-weight: 600;
    line-height: 1.3;
    text-wrap: balance;
  }

  .body {
    flex: 2 1 520px;
    min-width: 0;
    max-width: 700px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  :where(.body) > :global(p) {
    font-size: 17px;
    line-height: 1.75;
    color: var(--text-muted);
  }
</style>
