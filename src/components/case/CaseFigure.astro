---
/**
 * Screenshot figure for case pages: framed image, optional caption and
 * click-to-zoom (opens the page Lightbox with a large optimized version).
 *
 *   <CaseFigure src={img} alt="…" caption="…" />
 *   <CaseFigure src={img} alt="…" aspect="2/1" scroll />   ← tall shot scrolls inside a fixed frame
 */
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import { en, pt, type T } from '@/data/i18n';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Caption (inline HTML allowed). */
  caption?: T;
  /** Caption color: default/before (grey), after (cyan), process (lilac). */
  tone?: 'default' | 'before' | 'after' | 'process';
  /** Small uppercase mono caption instead of a sentence. */
  captionMono?: boolean;
  /** Fixed frame ratio (e.g. "2/1"). Defaults to the image's own ratio. */
  aspect?: string;
  /** With `aspect`: the image scrolls vertically inside the frame. */
  scroll?: boolean;
  /** Frame background behind transparent screenshots. */
  bg?: string;
  /** Show the frame shadow + radius (turn off for diagrams on dark). */
  framed?: boolean;
  zoom?: boolean;
  /** Responsive `sizes` hint. */
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  caption,
  tone = 'default',
  captionMono = false,
  aspect,
  scroll = false,
  bg = '#FAFAFA',
  framed = true,
  zoom = true,
  sizes = '(max-width: 1208px) 100vw, 1160px',
  loading = 'lazy',
  class: className,
} = Astro.props;

const zoomSrc = zoom
  ? (await getImage({ src, width: Math.min(src.width, 2400), format: 'webp' })).src
  : undefined;
const ratio = aspect ?? `${src.width}/${src.height}`;
const widths = [480, 800, 1120, 1600, 2240].filter((w) => w < src.width);
widths.push(Math.min(src.width, 2400));
---

<figure class:list={['fig', className]}>
  <div
    class:list={['frame', { 'frame--scroll': scroll, 'frame--bare': !framed }]}
    style={`aspect-ratio:${ratio};background:${bg}`}
    data-zoom={zoomSrc}
  >
    <Image src={src} alt={alt} width={Math.min(src.width, 1600)} widths={widths} sizes={sizes} loading={loading} />
  </div>
  {caption && <figcaption class:list={[`tone-${tone}`, { mono: captionMono }]} data-en={en(caption)} set:html={pt(caption)} />}
</figure>

<style>
  .fig {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    margin: 0;
  }

  .frame {
    overflow: hidden;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-shot);
  }

  .frame--bare {
    border-radius: 0;
    box-shadow: none;
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .frame--scroll {
    overflow-y: auto;
  }

  .frame--scroll img {
    height: auto;
  }

  figcaption {
    max-width: 760px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-subtle);
  }

  figcaption.mono {
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .tone-after {
    color: var(--gold);
  }

  .tone-process {
    color: var(--rose-light);
  }
</style>
