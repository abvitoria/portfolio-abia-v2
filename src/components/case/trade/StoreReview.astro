---
/** App store review card: title, age, stars, author and text. */
import { en, pt, type T } from '@/data/i18n';

interface Props {
  title: T;
  author: string;
  text: T;
  when: T;
  /** Rating out of 5. */
  stars?: number;
}

const { title, author, text, when, stars = 5 } = Astro.props;
---

<article class="review">
  <div class="row">
    <h3 data-en={en(title)} set:html={pt(title)} />
    <span class="meta" data-en={en(when)} set:html={pt(when)} />
  </div>
  <div class="row row--stars">
    <span class="stars" role="img" aria-label={`${stars} de 5 estrelas`}>{'★'.repeat(stars)}</span>
    <span class="meta">{author}</span>
  </div>
  <p data-en={en(text)} set:html={pt(text)} />
</article>

<style>
  .review {
    padding: 20px 22px;
    border-radius: 16px;
    background: #1a1a1d;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }

  .row--stars {
    align-items: center;
    margin: 4px 0 12px;
  }

  h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 800;
  }

  .meta {
    font-size: 12px;
    color: #7f7f9c;
  }

  .stars {
    font-size: 14px;
    letter-spacing: 2px;
    color: #f2a93b;
  }

  p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: #d2d1e6;
  }
</style>
