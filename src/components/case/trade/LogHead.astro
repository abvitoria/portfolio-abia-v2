---
/** Dashed mono header above a decision log: "Log de decisões ---- 01 — 05 · cadastro". */
import { en, pt, t, type T } from '@/data/i18n';

interface Props {
  range: T;
  label?: T;
}

const { range, label = t('Log de decisões', 'Decision log') } = Astro.props;
---

<div class="log-head">
  <span data-en={en(label)} set:html={pt(label)} />
  <span class="line" aria-hidden="true"></span>
  <span data-en={en(range)} set:html={pt(range)} />
</div>

<style>
  .log-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 4px;
    font-family: var(--ff-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--warm-40);
  }

  .line {
    flex: 1;
    height: 1px;
    background: repeating-linear-gradient(90deg, var(--warm-14) 0 5px, transparent 5px 9px);
  }
</style>
