---
/**
 * Two-column case section: sticky label + heading on the left, content on
 * the right (default slot). Full-width extras (figures, galleries) go in
 * the "wide" slot below the columns.
 */
import { en, pt, type T } from '@/data/i18n';

interface Props {
  id: string;
  label: T;
  /** Heading (inline HTML allowed). */
  title: T;
  /** Top spacing: md (64) after a part heading, lg (96), xl (120). */
  space?: 'md' | 'lg' | 'xl';
  /** Hide the hairline above the section. */
  noRule?: boolean;
}

const { id, label, title, space = 'xl', noRule = false } = Astro.props;
---

<section class:list={['section wrap--case', `space-${space}`]} aria-labelledby={`${id}-title`} id={id}>
  <div class:list={['cols', { rule: !noRule }]}>
    <header>
      <span class="tag-mono" data-en={en(label)} set:html={pt(label)} />
      <h2 id={`${id}-title`} data-en={en(title)} set:html={pt(title)} />
    </header>
    <div class="body">
      <slot />
    </div>
  </div>
  {
    Astro.slots.has('wide') && (
      <div class="wide">
        <slot name="wide" />
      </div>
    )
  }
</section>

<style>
  .section {
    margin: 0 auto;
  }

  .space-md {
    padding-top: calc(64px * var(--sp, 1));
  }

  .space-lg {
    padding-top: calc(96px * var(--sp, 1));
  }

  .space-xl {
    padding-top: calc(120px * var(--sp, 1));
  }

  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 72px;
  }

  .rule {
    padding-top: 40px;
    border-top: 1px solid var(--warm-14);
  }

  header {
    position: sticky;
    top: 104px;
    flex: 1 1 280px;
    align-self: flex-start;
    max-width: 360px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  h2 {
    margin: 0;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .body {
    flex: 2 1 520px;
    min-width: 0;
    max-width: 700px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  :where(.body) > :global(p) {
    font-size: 17px;
    line-height: 1.75;
    color: var(--text-muted);
  }

  .wide {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-top: 48px;
  }

  @media (max-width: 820px) {
    .cols {
      row-gap: 20px;
    }

    .rule {
      padding-top: 28px;
    }

    header {
      position: static;
    }

    .wide {
      margin-top: 32px;
    }
  }
</style>
