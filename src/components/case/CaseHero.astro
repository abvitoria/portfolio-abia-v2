---
/**
 * Case opening: back link, eyebrow, title, summary, cover and a facts strip
 * (role, team, scope, platform, status…).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { en, pt, type T } from '@/data/i18n';
import { url } from '@/lib/url';

interface Props {
  eyebrow: T;
  /** Title (inline HTML allowed). */
  title: T;
  summary: T;
  cover: ImageMetadata;
  coverAlt: string;
  facts: { label: T; value: T }[];
}

const { eyebrow, title, summary, cover, coverAlt, facts } = Astro.props;
---

<section class="hero wrap--case" aria-labelledby="case-title">
  <div class="top">
    <div class="intro">
      <a href={url('/cases/')} class="back" data-en="← Back to cases">← Voltar aos cases</a>
      <span class="tag-mono" data-en={en(eyebrow)} set:html={pt(eyebrow)} />
      <h1 id="case-title" data-en={en(title)} set:html={pt(title)} />
      <p class="summary" data-en={en(summary)} set:html={pt(summary)} />
    </div>
    <Image
      class="cover"
      src={cover}
      alt={coverAlt}
      widths={[480, 800, 1120]}
      sizes="(max-width: 960px) 100vw, 560px"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <dl class="facts">
    {
      facts.map((f) => (
        <div>
          <dt data-en={en(f.label)} set:html={pt(f.label)} />
          <dd data-en={en(f.value)} set:html={pt(f.value)} />
        </div>
      ))
    }
  </dl>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 56px;
    margin: 0 auto;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 48px 72px;
  }

  .intro {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .back {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .back:hover {
    color: var(--warm);
  }

  h1 {
    margin: 0;
    font-size: clamp(36px, 4.4vw, 56px);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .summary {
    font-size: 19px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  .hero :global(.cover) {
    flex: 1 1 420px;
    min-width: 0;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    margin: 0;
    border-block: 1px solid var(--warm-14);
  }

  .facts div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 24px 20px 0;
  }

  dt {
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  dd {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.45;
  }
</style>
