---
/** StartDev home ("Início") shown, scaled down, in the case hero. */
import AppWindow from './AppWindow.astro';
import SdIcon from './SdIcon.astro';

const lessons = [
  { title: 'O que é um algoritmo', meta: '+40', state: 'done' },
  { title: 'Pseudocódigo e fluxogramas', meta: '+40', state: 'done' },
  { title: 'Variáveis e tipos de dados', meta: 'agora', state: 'now' },
  { title: 'Atividade · Caixa de mercado', meta: '+60', state: 'todo' },
  { title: 'Operadores e expressões', meta: '+40', state: 'todo' },
] as const;
---

<AppWindow
  url="app.startdev.com.br/inicio"
  nav="inicio"
  foot={false}
  label="Tela inicial da plataforma StartDev: aula em andamento, trilha da semana e pontos"
  notifications="Notificações: 2 não lidas"
  class="hero-mock"
>
  <span slot="top" class="streak"><SdIcon name="flame" size={15} />4 dias seguidos</span>
  <div class="sd-main">
    <div class="sd-hd">
      <div>
        <p class="sd-crumb">Painel do aluno</p>
        <h1 class="sd-h1">Continue de onde parou</h1>
      </div>
      <span class="progress-note">Módulo 01 · 2 de 5 aulas</span>
    </div>

    <div class="sd-card now">
      <div class="video">
        <span class="bubble" aria-hidden="true"></span>
        <span class="play"><SdIcon name="play" size={17} /></span>
        <span class="time">09:52 / 45:00</span>
      </div>
      <div>
        <span class="sd-chip sd-chip--tint">Aula em andamento</span>
        <div class="title">Variáveis e tipos de dados</div>
        <div class="meta">Lógica de programação · Aula 03 de 05 · 12 min restantes</div>
        <div class="bar">
          <div class="sd-track" style="--p:40%"><span></span></div>
          <span>40%</span>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="sd-card week">
        <div class="week-head">
          <span>Sua trilha da semana</span>
          <span class="see">Ver tudo</span>
        </div>
        {
          lessons.map((l) => (
            <div class:list={['sd-lesson', l.state, { on: l.state === 'now' }]}>
              <span class:list={['sd-dot', { 'sd-dot--done': l.state === 'done', 'sd-dot--now': l.state === 'now' }]}>
                {l.state === 'done' && <SdIcon name="check" size={10} stroke={3.4} />}
                {l.state === 'now' && <SdIcon name="play" size={9} />}
              </span>
              <span class="tt">{l.title}</span>
              <span class="mn">{l.meta}</span>
            </div>
          ))
        }
      </div>
      <div class="side">
        <div class="sd-card points">
          <span class="ring"><span>72%</span></span>
          <div>
            <div class="sd-label">Pontos · nível Prata</div>
            <div class="score"><strong>840</strong><span>+120 na semana</span></div>
            <div class="meta">160 pontos para o nível Ouro</div>
          </div>
        </div>
        <div class="sd-card topics">
          <span class="ico"><SdIcon name="bubble" size={18} /></span>
          <div>
            <div class="topics-title">2 tópicos novos no fórum</div>
            <div class="meta ellipsis">"Alguém entendeu a atividade do caixa?"</div>
          </div>
          <SdIcon name="right" size={14} stroke={2.4} class="chev" />
        </div>
      </div>
    </div>
  </div>
</AppWindow>

<style>
  .hero-mock {
    position: relative;
    flex: none;
    width: 1120px;
    min-width: 1120px;
    zoom: 0.47;
    filter: drop-shadow(0 26px 46px rgba(40, 24, 110, 0.28));
  }

  @media (max-width: 1140px) and (min-width: 901px) {
    .hero-mock {
      zoom: 0.36;
    }
  }

  @media (max-width: 900px) {
    .hero-mock {
      zoom: 0.5;
    }
  }

  @media (max-width: 680px) {
    .hero-mock {
      zoom: 0.33;
    }
  }

  /* Fit 1120px into a 342px phone column */
  @media (max-width: 420px) {
    .hero-mock {
      zoom: 0.29;
    }
  }

  /* The scaled mock keeps its desktop grid at every width. */
  .hero-mock :global(.sd-body) {
    grid-template-columns: 96px minmax(0, 1fr);
  }

  .hero-mock :global(.sd-rail) {
    flex-direction: column;
    border-right: 1px solid var(--sd-line-2);
    border-bottom: none;
  }

  .hero-mock :global(.sd-rail > *) {
    border-bottom: none;
    border-left: 3px solid transparent;
  }

  .hero-mock :global(.sd-rail > .on) {
    border-left-color: var(--sd-blue);
  }

  .streak {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 34px;
    padding: 0 13px;
    border-radius: 999px;
    background: #fef3e2;
    font-size: 12.5px;
    font-weight: 700;
    color: #92400e;
  }

  .streak :global(svg) {
    color: #f59e0b;
  }

  .sd-main {
    gap: 20px;
    padding: 26px 30px 30px;
  }

  .sd-hd {
    align-items: flex-end;
    gap: 16px;
  }

  .sd-h1 {
    font-size: 25px;
  }

  .progress-note {
    margin-left: auto;
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
    color: var(--sd-muted-2);
  }

  .meta {
    margin-top: 3px;
    font-size: 12.5px;
    color: var(--sd-muted-2);
  }

  .now {
    display: grid;
    grid-template-columns: 216px minmax(0, 1fr);
    gap: 20px;
    align-items: center;
    padding: 18px;
  }

  .video {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 122px;
    border-radius: 11px;
    background: linear-gradient(140deg, #03337b, #0b46c4 60%, #2563eb);
  }

  .bubble {
    position: absolute;
    top: -34px;
    right: -30px;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
  }

  .play {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    color: #0b3fa8;
  }

  .time {
    position: absolute;
    left: 10px;
    bottom: 9px;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.85);
  }

  .title {
    margin-top: 9px;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--sd-navy);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-top: 13px;
    font-size: 11.5px;
    font-weight: 700;
    color: var(--sd-blue);
  }

  .bar .sd-track {
    flex: 1;
    height: 7px;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.28fr) minmax(0, 1fr);
    gap: 18px;
    align-items: start;
  }

  .week {
    padding: 16px 16px 12px;
  }

  .week-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 0 4px 10px;
    font-size: 14px;
    font-weight: 700;
    color: var(--sd-navy);
  }

  .see {
    font-size: 12px;
    color: var(--sd-blue);
  }

  .done .tt {
    color: #8a93a3;
  }

  .done .mn {
    color: var(--sd-green);
  }

  .on .mn {
    color: var(--sd-blue);
  }

  .done .sd-dot--done {
    background: #dcfce7;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .points {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
  }

  .ring {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: conic-gradient(#0b46c4 0 72%, #e6eaf3 0);
  }

  .ring span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #fff;
    font-size: 11px;
    font-weight: 700;
    color: var(--sd-navy);
  }

  .points .sd-label {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--sd-muted-2);
  }

  .score {
    display: flex;
    align-items: baseline;
    gap: 7px;
    font-size: 12px;
    font-weight: 700;
    color: var(--sd-green);
  }

  .score strong {
    font-size: 24px;
    line-height: 1.15;
    color: var(--sd-blue);
  }

  .points .meta,
  .topics .meta {
    margin-top: 0;
    font-size: 12px;
  }

  .topics {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 16px;
  }

  .topics > div {
    flex: 1;
    min-width: 0;
  }

  .ico {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: #fee9d8;
    color: #9a3412;
  }

  .topics-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--sd-navy);
  }

  .topics .meta {
    font-size: 11.5px;
  }

  .ellipsis {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .chev {
    flex: none;
    color: var(--sd-blue);
  }
</style>
