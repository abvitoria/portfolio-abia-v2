---
/** Light vs dark: the same lesson card in both StartDev themes + the paired color tokens. */
import { t } from '@/data/i18n';

const themes = [
  { label: t('Claro', 'Light'), dark: false },
  { label: t('Escuro', 'Dark'), dark: true },
];
const tokens = [
  { name: t('superfície', 'surface'), light: '#FFFFFF', dark: '#111B2E' },
  { name: t('borda', 'border'), light: '#EBEEF3', dark: '#22304C' },
  { name: t('texto', 'text'), light: '#03337B', dark: '#EAF1FB' },
  { name: t('ação', 'action'), light: '#013DAB', dark: '#7FB3FF' },
];
---

<div class="pairs">
  <div class="themes">
    {
      themes.map((th) => (
        <div class="theme">
          <span class="theme-label" data-en={th.label.en} set:html={th.label.pt} />
          <div class:list={['lesson', { 'lesson--dark': th.dark }]}>
            <div class="head">
              <span class="name">Variáveis e tipos de dados</span>
              <span class="time">45 min</span>
            </div>
            <div class="meta">Módulo 01 · Aula 03</div>
            <div class="track">
              <span />
            </div>
          </div>
        </div>
      ))
    }
  </div>
  <div class="rule"></div>
  <div class="tokens">
    {
      tokens.map((tk) => (
        <div class="token">
          <span class="swatch" style={`--l:${tk.light};--d:${tk.dark}`} />
          <span data-en={tk.name.en} set:html={tk.name.pt} />
        </div>
      ))
    }
  </div>
  <p data-en="Every token has a pair in both themes — the same component switches theme without losing contrast.">Cada token tem par nos dois temas — o mesmo componente troca de tema sem perder contraste.</p>
</div>

<style>
  .pairs {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border-radius: 18px;
    background: radial-gradient(120% 120% at 25% 0%, var(--plum), #070838);
  }

  .themes,
  .tokens {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .tokens {
    gap: 10px 16px;
  }

  .theme {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .theme-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rose-light);
  }

  /* Product colors (StartDev light / dark themes) */
  .lesson {
    padding: 13px 14px;
    border: 1px solid #ebeef3;
    border-radius: 13px;
    background: #fff;
  }

  .lesson--dark {
    border-color: #22304c;
    background: #111b2e;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 8px;
  }

  .name {
    font-size: 12px;
    font-weight: 600;
    color: #03337b;
  }

  .time {
    font-size: 10px;
    font-weight: 700;
    white-space: nowrap;
    color: #013dab;
  }

  .meta {
    margin-top: 4px;
    font-size: 10.5px;
    color: #7c8699;
  }

  .track {
    overflow: hidden;
    height: 5px;
    margin-top: 10px;
    border-radius: 4px;
    background: #e6eaf3;
  }

  .track span {
    display: block;
    width: 40%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #0b46c4, #4c86f5);
  }

  .lesson--dark .name {
    color: #eaf1fb;
  }

  .lesson--dark .time {
    color: #7fb3ff;
  }

  .lesson--dark .meta {
    color: #8698b5;
  }

  .lesson--dark .track {
    background: #1e2a42;
  }

  .lesson--dark .track span {
    background: linear-gradient(90deg, #4c86f5, #7fb3ff);
  }

  .rule {
    height: 1px;
    background: var(--warm-14);
  }

  .token {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-muted);
  }

  /* Two halves: light value | dark value */
  .swatch {
    flex: none;
    width: 32px;
    height: 16px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 4px;
    background: linear-gradient(90deg, var(--l) 50%, var(--d) 50%);
  }

  p {
    margin: 0;
    font-size: 11.5px;
    line-height: 1.55;
    color: var(--text-muted);
  }
</style>
