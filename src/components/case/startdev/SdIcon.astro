  search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>',
  check: '<path d="M4 12.5l5.5 5.5L20 6.5"/>',
  x: '<path d="M6 6l12 12"/><path d="M18 6L6 18"/>',
  plus: '<path d="M12 5v14"/><path d="M5 12h14"/>',
  send: '<path d="M21 4L3 11l7 2.6L12.6 21z"/><path d="M21 4L10 13.6"/>',
  chat: '<path d="M20 15a3 3 0 0 1-3 3H8l-4 3V6a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3z"/>',
  bubble: '<path d="M21 12a8 8 0 0 1-11.3 7.3L4 21l1.7-5.7A8 8 0 1 1 21 12z"/>',
  alert: '<circle cx="12" cy="12" r="8.5"/><path d="M12 8v4.5"/><path d="M12 16h.01"/>',
  star: '<path d="M12 3l2.6 5.6 6.1.8-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L3.3 9.4l6.1-.8z"/>',
  link: '<path d="M10 13a4 4 0 0 0 5.7 0l2.6-2.6a4 4 0 1 0-5.7-5.7L11.4 6"/><path d="M14 11a4 4 0 0 0-5.7 0l-2.6 2.6a4 4 0 1 0 5.7 5.7L12.6 18"/>',
  code: '<path d="M9 5L4 12l5 7"/><path d="M15 5l5 7-5 7"/>',
  list: '<path d="M9 6h11"/><path d="M9 12h11"/><path d="M9 18h11"/><circle cx="4.5" cy="6" r="1.3"/><circle cx="4.5" cy="12" r="1.3"/><circle cx="4.5" cy="18" r="1.3"/>',
  listOl: '<path d="M9 6h11"/><path d="M9 12h11"/><path d="M9 18h11"/><path d="M4 5.5h1.6V9"/><path d="M3.6 15.2c1.2-1.2 2.4-.4 2.4.5C6 16.8 3.6 17 3.6 18.6H6"/>',
  image: '<rect x="3" y="4" width="18" height="16" rx="2.5"/><circle cx="8.5" cy="9.5" r="1.6"/><path d="M4 17l5-4.5 4 3.5 3-2.5 4 3.5"/>',
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>',
  brackets: '<path d="M9 18l-6-6 6-6"/><path d="M15 6l6 6-6 6"/>',
  lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  users: '<circle cx="9" cy="9" r="3"/><path d="M3 19c1-3 3.2-4.4 6-4.4S14 16 15 19"/><path d="M16 6.2a3 3 0 0 1 0 5.6"/>',
  house: '<path d="M4 20V9l8-5 8 5v11"/><path d="M10 20v-6h4v6"/>',
  thumbUp: '<path d="M7 21V10l5-7 1.6 1.2a2 2 0 0 1 .7 2L13 10h5.5a2 2 0 0 1 2 2.4l-1.4 7A2 2 0 0 1 17 21z"/><path d="M7 10H4v11h3"/>',
  thumbDown: '<path d="M17 3v11l-5 7-1.6-1.2a2 2 0 0 1-.7-2L11 14H5.5a2 2 0 0 1-2-2.4l1.4-7A2 2 0 0 1 7 3z"/><path d="M17 14h3V3h-3"/>',
  reply: '<path d="M9 5L4 10l5 5"/><path d="M4 10h10a6 6 0 0 1 6 6v3"/>',
  up: '<path d="M6 15l6-6 6 6"/>',
  down: '<path d="M6 9l6 6 6-6"/>',
  left: '<path d="M14 6l-6 6 6 6"/>',
  right: '<path d="M9 6l6 6-6 6"/>',
  play: '<path d="M7 4l13 8-13 8z"/>',
  flame: '<path d="M13 2c.5 4-2.5 5.5-2.5 8.5A2.5 2.5 0 0 0 13 13c2 0 3-1.5 3-3 2 1.6 3 3.7 3 6a7 7 0 1 1-14 0C5 9 9.5 6.5 13 2z"/>',
  signal: '<rect x="0" y="8" width="3" height="4" rx="1"/><rect x="5" y="5" width="3" height="7" rx="1"/><rect x="10" y="2" width="3" height="10" rx="1"/><rect x="15" y="0" width="3" height="12" rx="1" opacity=".4"/>',
};

/** Icons drawn as filled shapes instead of strokes. */
const filled = new Set(['play', 'flame', 'signal']);

export type SdIconName = keyof typeof icons;

interface Props {
  name: SdIconName;
  size?: number;
  /** Stroke width (ignored for filled icons). */
  stroke?: number;
  class?: string;
}

const { name, size = 16, stroke = 1.9, class: className } = Astro.props;
const fill = filled.has(name);
---

<svg
  class={className}
  width={name === 'signal' ? 14 : size}
  height={name === 'signal' ? 10 : size}
  viewBox={name === 'signal' ? '0 0 18 12' : '0 0 24 24'}
  fill={fill ? 'currentColor' : 'none'}
  stroke={fill ? undefined : 'currentColor'}
  stroke-width={fill ? undefined : stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={icons[name]}
/>
