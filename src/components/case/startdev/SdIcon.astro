---
/**
 * Line icons of the StartDev product mockups (24×24, currentColor).
 *   <SdIcon name="forum" size={21} />
 */
const icons = {
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/>',
  courses: '<path d="M2 8l10-4 10 4-10 4z"/><path d="M6 10.5V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-5.5"/>',
  activities: '<path d="M4 20h16"/><path d="M15.5 4.5l4 4L9 19H5v-4z"/>',
  forum: '<path d="M21 12a8 8 0 1 1-3.2-6.4"/><path d="M3 20l1.6-4"/>',
  shop: '<circle cx="10" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M3 4h2l2.6 10.5h11"/><path d="M6.5 7.5H21l-1.8 6H8"/>',
