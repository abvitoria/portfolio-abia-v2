---
/**
 * Artifact (diagram, wireframe, style guide…) on a dark bordered panel, with
 * a small caption and click-to-zoom through the page Lightbox.
 *
 *   <PanelFigure src={img} alt="…" caption="…" width={640} centered />
 */
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
import { getImage, Image } from 'astro:assets';

type Props = Omit<HTMLAttributes<'figure'>, 'class'> & {
  src: ImageMetadata;
  alt: string;
  /** Caption (inline HTML allowed). */
  caption?: string;
  /** Max panel width in px (full column when omitted). */
  width?: number;
  /** Panel padding in px. */
  padding?: number;
  /** Center the caption under a narrow panel. */
  centered?: boolean;
  class?: string;
};

const { src, alt, caption, width, padding = 20, centered = false, class: className, ...attrs } = Astro.props;

// Some diagrams are huge (a user flow is 13k px wide): cap every generated size.
const shown = width ?? 1080;
const widths = [480, shown, shown * 2].map((w) => Math.min(w, src.width));
const zoomSrc = (await getImage({ src, width: Math.min(src.width, 2400), format: 'webp' })).src;
---

<figure
  class:list={['panel-fig', { 'panel-fig--center': centered }, className]}
  style={width && `--w:${width}px`}
  {...attrs}
>
  <div class="panel" style={`--pad:${padding}px`} data-zoom={zoomSrc}>
    <Image
      src={src}
      alt={alt}
      width={Math.min(src.width, shown * 2)}
      widths={[...new Set(widths)]}
      sizes={`(max-width: ${shown + 48}px) 100vw, ${shown}px`}
    />
  </div>
  {caption && <figcaption set:html={caption} />}
</figure>

<style>
  .panel-fig {
    margin: 0;
  }

  .panel {
    max-width: var(--w, none);
    margin: 0 auto;
    padding: var(--pad);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 18px;
    background: rgba(10, 12, 74, 0.94);
  }

  .panel img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  figcaption {
    margin-top: 12px;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .panel-fig--center figcaption {
    max-width: var(--w, none);
    margin-inline: auto;
    text-align: center;
  }
</style>
